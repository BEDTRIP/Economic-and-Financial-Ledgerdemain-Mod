# Probe R4б.1 (Р26): a company's "Bank" levels and its variable, read by the window and handed to script
# (scripted_guis/ld_probe_bk.txt). The pattern of gui/ld_money_hook.gui: an item per entry of a global list, a state
# that fires on_finish when the item exists; each state tests one expression (a failing one is a nullptr in error.log,
# the others still pass); the last one (after a second) takes the company off the list. To _archive/ld_probe_bk/
# after the run.
widget = {
	name = ld_probe_bk_hook
	datacontext = "[GetMetaPlayer.GetPlayedOrObservedCountry]"
	visible = "[GetMetaPlayer.GetPlayedOrObservedCountry.IsValid]"
	size = { 500 500 }
	allow_outside = yes
	alwaystransparent = yes
	alpha = 1

	flowcontainer = {
		visible = "[DataModelHasItems(GetGlobalList('ld_pb_companies'))]"
		datamodel = "[GetGlobalList('ld_pb_companies')]"
		item = {
			widget = {
				datacontext = "[Scope.GetCompany]"
				# a literal: the bridge with a company as root
				state = {
					trigger_when = "[Scope.IsSet]"
					on_finish = "[GetScriptedGui('ld_probe_bk_v_sg').Execute( GuiScope.SetRoot( Company.MakeScope ).AddScope( 'v', MakeScopeValue( '(CFixedPoint)5' ) ).AddScope( 'w', MakeScopeFlag( 'five' ) ).End )]"
				}
				# the company's variable as the window reads it
				state = {
					trigger_when = "[Scope.IsSet]"
					on_finish = "[GetScriptedGui('ld_probe_bk_v_sg').Execute( GuiScope.SetRoot( Company.MakeScope ).AddScope( 'v', MakeScopeValue( Company.MakeScope.Var('ld_pb_n').GetValue ) ).AddScope( 'w', MakeScopeFlag( 'n_gui' ) ).End )]"
				}
				# int32 -> fixed point bit by bit (IntToFixedPoint gives a float that MakeScopeValue does not take): a literal
				state = {
					trigger_when = "[Scope.IsSet]"
					on_finish = "[GetScriptedGui('ld_probe_bk_v_sg').Execute( GuiScope.SetRoot( Company.MakeScope ).AddScope( 'v', MakeScopeValue( Select_CFixedPoint( IsOdd_int32( '(int32)5' ), '(CFixedPoint)1', '(CFixedPoint)0' ) ) ).AddScope( 'w', MakeScopeFlag( 'five_i' ) ).End )]"
				}
				# the company's bank levels: as the vanilla companies panel reads them (companies_panel.gui)
				state = {
					trigger_when = "[Scope.IsSet]"
					on_finish = "[GetScriptedGui('ld_probe_bk_v_sg').Execute( GuiScope.SetRoot( Company.MakeScope ).AddScope( 'v', MakeScopeValue( Add_CFixedPoint( Add_CFixedPoint( Add_CFixedPoint( Add_CFixedPoint( Add_CFixedPoint( Add_CFixedPoint( Add_CFixedPoint( Add_CFixedPoint( Add_CFixedPoint( Select_CFixedPoint( IsOdd_int32( Divide_int32( GetBuildingType('building_zz_ef_bank').GetNumLevelsOwnedByCompanyRaw( Company.Self ), '(int32)1' ) ), '(CFixedPoint)1', '(CFixedPoint)0' ), Select_CFixedPoint( IsOdd_int32( Divide_int32( GetBuildingType('building_zz_ef_bank').GetNumLevelsOwnedByCompanyRaw( Company.Self ), '(int32)2' ) ), '(CFixedPoint)2', '(CFixedPoint)0' ) ), Select_CFixedPoint( IsOdd_int32( Divide_int32( GetBuildingType('building_zz_ef_bank').GetNumLevelsOwnedByCompanyRaw( Company.Self ), '(int32)4' ) ), '(CFixedPoint)4', '(CFixedPoint)0' ) ), Select_CFixedPoint( IsOdd_int32( Divide_int32( GetBuildingType('building_zz_ef_bank').GetNumLevelsOwnedByCompanyRaw( Company.Self ), '(int32)8' ) ), '(CFixedPoint)8', '(CFixedPoint)0' ) ), Select_CFixedPoint( IsOdd_int32( Divide_int32( GetBuildingType('building_zz_ef_bank').GetNumLevelsOwnedByCompanyRaw( Company.Self ), '(int32)16' ) ), '(CFixedPoint)16', '(CFixedPoint)0' ) ), Select_CFixedPoint( IsOdd_int32( Divide_int32( GetBuildingType('building_zz_ef_bank').GetNumLevelsOwnedByCompanyRaw( Company.Self ), '(int32)32' ) ), '(CFixedPoint)32', '(CFixedPoint)0' ) ), Select_CFixedPoint( IsOdd_int32( Divide_int32( GetBuildingType('building_zz_ef_bank').GetNumLevelsOwnedByCompanyRaw( Company.Self ), '(int32)64' ) ), '(CFixedPoint)64', '(CFixedPoint)0' ) ), Select_CFixedPoint( IsOdd_int32( Divide_int32( GetBuildingType('building_zz_ef_bank').GetNumLevelsOwnedByCompanyRaw( Company.Self ), '(int32)128' ) ), '(CFixedPoint)128', '(CFixedPoint)0' ) ), Select_CFixedPoint( IsOdd_int32( Divide_int32( GetBuildingType('building_zz_ef_bank').GetNumLevelsOwnedByCompanyRaw( Company.Self ), '(int32)256' ) ), '(CFixedPoint)256', '(CFixedPoint)0' ) ), Select_CFixedPoint( IsOdd_int32( Divide_int32( GetBuildingType('building_zz_ef_bank').GetNumLevelsOwnedByCompanyRaw( Company.Self ), '(int32)512' ) ), '(CFixedPoint)512', '(CFixedPoint)0' ) ) ) ).AddScope( 'w', MakeScopeFlag( 'lv' ) ).End )]"
				}
				# the same through Company.GetBuildingTypeLevels
				state = {
					trigger_when = "[Scope.IsSet]"
					on_finish = "[GetScriptedGui('ld_probe_bk_v_sg').Execute( GuiScope.SetRoot( Company.MakeScope ).AddScope( 'v', MakeScopeValue( Add_CFixedPoint( Add_CFixedPoint( Add_CFixedPoint( Add_CFixedPoint( Add_CFixedPoint( Add_CFixedPoint( Add_CFixedPoint( Add_CFixedPoint( Add_CFixedPoint( Select_CFixedPoint( IsOdd_int32( Divide_int32( Company.GetBuildingTypeLevels( GetBuildingType('building_zz_ef_bank').Self ), '(int32)1' ) ), '(CFixedPoint)1', '(CFixedPoint)0' ), Select_CFixedPoint( IsOdd_int32( Divide_int32( Company.GetBuildingTypeLevels( GetBuildingType('building_zz_ef_bank').Self ), '(int32)2' ) ), '(CFixedPoint)2', '(CFixedPoint)0' ) ), Select_CFixedPoint( IsOdd_int32( Divide_int32( Company.GetBuildingTypeLevels( GetBuildingType('building_zz_ef_bank').Self ), '(int32)4' ) ), '(CFixedPoint)4', '(CFixedPoint)0' ) ), Select_CFixedPoint( IsOdd_int32( Divide_int32( Company.GetBuildingTypeLevels( GetBuildingType('building_zz_ef_bank').Self ), '(int32)8' ) ), '(CFixedPoint)8', '(CFixedPoint)0' ) ), Select_CFixedPoint( IsOdd_int32( Divide_int32( Company.GetBuildingTypeLevels( GetBuildingType('building_zz_ef_bank').Self ), '(int32)16' ) ), '(CFixedPoint)16', '(CFixedPoint)0' ) ), Select_CFixedPoint( IsOdd_int32( Divide_int32( Company.GetBuildingTypeLevels( GetBuildingType('building_zz_ef_bank').Self ), '(int32)32' ) ), '(CFixedPoint)32', '(CFixedPoint)0' ) ), Select_CFixedPoint( IsOdd_int32( Divide_int32( Company.GetBuildingTypeLevels( GetBuildingType('building_zz_ef_bank').Self ), '(int32)64' ) ), '(CFixedPoint)64', '(CFixedPoint)0' ) ), Select_CFixedPoint( IsOdd_int32( Divide_int32( Company.GetBuildingTypeLevels( GetBuildingType('building_zz_ef_bank').Self ), '(int32)128' ) ), '(CFixedPoint)128', '(CFixedPoint)0' ) ), Select_CFixedPoint( IsOdd_int32( Divide_int32( Company.GetBuildingTypeLevels( GetBuildingType('building_zz_ef_bank').Self ), '(int32)256' ) ), '(CFixedPoint)256', '(CFixedPoint)0' ) ), Select_CFixedPoint( IsOdd_int32( Divide_int32( Company.GetBuildingTypeLevels( GetBuildingType('building_zz_ef_bank').Self ), '(int32)512' ) ), '(CFixedPoint)512', '(CFixedPoint)0' ) ) ) ).AddScope( 'w', MakeScopeFlag( 'lv2' ) ).End )]"
				}
				# then off the list
				state = {
					trigger_when = "[Scope.IsSet]"
					duration = 1
					on_finish = "[GetScriptedGui('ld_probe_bk_done_sg').Execute( GuiScope.SetRoot( Company.MakeScope ).End )]"
				}
			}
		}
	}
}
