					blockoverride "onclick_showmore" {
						visible = "[Not(GetVariableSystem.Exists('stockpile_panel'))]"
					}

					blockoverride "onclick_showless" {
						visible = "[GetVariableSystem.Exists('stockpile_panel')]"
					}
					size = { 520 40 }
