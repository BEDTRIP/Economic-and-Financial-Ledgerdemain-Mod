											margin = { 10 5 }
										}
										minimumsize = { 150 60 }
										maximumsize = { 150 -1 }
									}
								}

								######################################
								block "divider" {
									divider_decorative = {
									}
								}
								#selection 5/10Y
								flowcontainer  = {
									margin_top = 0
									margin_right = 0
									margin_left = 0

									spacing = 10

									direction = horizontal
									parentanchor = hcenter

