														parentanchor = hcenter
														align = hcenter|nobaseline

														margin_right = 0
														margin_bottom = 0
													}

													background = {
														using = entry_bg_simple
														margin = { 10 5 }
													}
												}
												#1 month
												flowcontainer = {
													margin_top = 0
													margin_right = 0
													margin_left = 0
													margin_bottom = 0

													spacing = 5

													direction = vertical

													parentanchor = left

													flowcontainer = {
														margin_top = 0
														margin_right = 0
														margin_left = 0
														margin_bottom = 0

														spacing = 5

														direction = horizontal

														parentanchor = left

														textbox = {
															using = fontsize_large
															autoresize = yes
															text = "total_1_month"

															parentanchor = left
															align = left|nobaseline
															margin_right = 0
															margin_bottom = 0
														}

														textbox = {
															using = fontsize_large
															autoresize = yes
															text = "@opium!"

															parentanchor = left
															align = left|nobaseline
															margin_right = 0
															margin_bottom = 0
														}
													}

