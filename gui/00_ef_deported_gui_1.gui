										margin_left = 0
										margin_bottom = 0

										spacing = 1
										direction = vertical

										textbox = {
											using = fontsize_large
											autoresize = yes
											text = "[concept_base_interest_value_10Y]"
											parentanchor = hcenter
											align = hcenter|nobaseline
											elide = right
											fontsize = 17

											multiline = yes
											minimumsize = { 150 40 }
											maximumsize = { 150 -1 }
										}
										textbox = {
