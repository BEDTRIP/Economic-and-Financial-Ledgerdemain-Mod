			#central_bank_metal_reserves_TITLE
			default_header = {
				blockoverride "text" {
					text = "CENTRAL_BANK_METAL_RESERVES_TITLE"
				}
			}
			flowcontainer  = {
				parentanchor = hcenter
				direction = vertical

				#monetary_system_based_on_metals ok
				flowcontainer  = {
					visible = "[GetScriptedGui('monetary_system_based_on_metals').IsShown( GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
					parentanchor = hcenter
					direction = vertical


					flowcontainer  = {
						margin_top = 0
						margin_right = 0
						margin_left = 0

						direction = vertical
						parentanchor = hcenter

						spacing = 5
						
						flowcontainer  = {
							margin_top = 0
							margin_right = 0
							margin_left = 0

							spacing = 5

							direction = vertical
							parentanchor = hcenter

							flowcontainer  = {
								margin_top = 0
								margin_right = 0
								margin_left = 0

