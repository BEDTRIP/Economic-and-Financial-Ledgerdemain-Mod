						#larg
						section_header_button = {

							blockoverride "left_text" {
								text = "[concept_long_term_monetary_policy]"
							}

							blockoverride "onclick" {
								onclick = "[GetVariableSystem.Toggle('large_monetary_policy')]"
								onclick = "[GetScriptedGui('large_monetary_policy_list_gerenation_ordered').Execute( GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
								onclick = "[GetScriptedGui('country_credit_rating_actualized').Execute( GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
							}

							blockoverride "onclick_showmore" {
								visible = "[Not(GetVariableSystem.Exists('large_monetary_policy'))]"
							}

							blockoverride "onclick_showless" {
								visible = "[GetVariableSystem.Exists('large_monetary_policy')]"
							}
						}
						flowcontainer = {
							using = default_list_position
							direction = vertical
							visible = "[GetVariableSystem.Exists('large_monetary_policy')]"
							#margin_bottom = 10
							margin_top = 10

							#has_tech and law
							flowcontainer = {
								visible = "[GetScriptedGui('has_monetary_policy_tools_tech_visibility').IsShown( GuiScope.SetRoot(GetPlayer.MakeScope).End)]"

								margin_top = 0
								margin_right = 0
								margin_left = 0

								parentanchor = hcenter

								spacing = 15

								direction = vertical

								#button
								flowcontainer  = {
									margin_top = 0
									margin_right = 0
									margin_left = 0

									spacing = 10

									direction = horizontal
									parentanchor = hcenter

									button_icon_square = {
										name = "Devaluation"
										size = { 250 40 }

										using = tooltip_below
										enabled = "[GetScriptedGui('devaluation_visibility').IsValid( GuiScope.SetRoot(GetPlayer.MakeScope ).End)]"

										onclick = "[GetScriptedGui('devaluation_visibility').Execute( GuiScope.SetRoot(GetPlayer.MakeScope ).End)]"
										textbox = {
											using = fontsize_large
											autoresize = yes
											text = "devaluation"
											parentanchor = vcenter|hcenter
											default_format = "#white #bold"
											align = hcenter
										}
									}
									button_icon_square = {
										name = "Revaluation"
										size = { 250 40 }

										using = tooltip_below
										enabled = "[GetScriptedGui('revaluation_visibility').IsValid( GuiScope.SetRoot(GetPlayer.MakeScope ).End)]"
 
										onclick = "[GetScriptedGui('revaluation_visibility').Execute( GuiScope.SetRoot(GetPlayer.MakeScope ).End)]"
										textbox = {
											using = fontsize_large
											autoresize = yes
											text = "revaluation"
											default_format = "#white #bold"
											parentanchor = vcenter|hcenter
											align = hcenter
										}
									}
								} 

								#Devaluation
								flowcontainer = {
									visible = "[GetScriptedGui('devaluation_visibility').IsShown( GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
									margin_top = 0
									margin_right = 0
									margin_left = 0

									parentanchor = hcenter

									spacing = 15

									direction = vertical

									flowcontainer = {
										spacing = 25
										direction = horizontal

										#money_value
										flowcontainer = {
											spacing = 0
											direction = vertical

											textbox = {
												autoresize = yes
												text = "[concept_money_value]"
												align = nobaseline
												parentanchor = Hcenter
												fontsize = 20
											}

											textbox = {
												autoresize = yes
												text = "[GetPlayer.MakeScope.ScriptValue('money_value')|+D] [GetMetaPlayer.GetPlayedOrObservedCountry.GetCustom('currency_symbol')]"
												align = nobaseline
												parentanchor = Hcenter
												fontsize = 20
											}

											textbox = {
												autoresize = yes
												text = "([GetPlayer.MakeScope.ScriptValue('money_value_predicted_devaluation')|+D] [GetMetaPlayer.GetPlayedOrObservedCountry.GetCustom('currency_symbol')])"
												align = nobaseline
												parentanchor = Hcenter
												fontsize = 20
											}

											background = {
												using = entry_bg_simple
												margin = { 10 10 }
											}

											minimumsize = { 100 110 }
											maximumsize = { 100 -1 }
										}

										#money_supply
