types market_states_panel
{
	type market_global_panel_content = flowcontainer {
		margin_top = 10
		direction = vertical
		using = default_list_position
		spacing = 5

		#not
		flowcontainer = {
			visible = "[GetScriptedGui('not_is_ai').IsShown( GuiScope.SetRoot(Market.GetOwner.MakeScope).End)]"

			using = default_content_fade
			direction = vertical
			using = default_list_position
			spacing = 10

			textbox = {
				text = "select_a_foreign_market"
				autoresize = yes
				align = hcenter
				parentanchor = hcenter
				using = fontsize_large
				fontsize = 40
			}
		}

		#yes
		flowcontainer = {
			visible = "[GetScriptedGui('is_ai').IsShown( GuiScope.SetRoot(Market.GetOwner.MakeScope).End)]"

			using = default_content_fade
			direction = vertical
			using = default_list_position
			spacing = 10

			default_header = {
				blockoverride "text" {
					text = "comparison_of_countries"
				}
			}

			#comparison_of_countries
			flowcontainer = {
				margin_top = 0
				margin_right = 0
				margin_left = 0
				margin_bottom = 10

				direction = horizontal
				parentanchor = hcenter

				spacing = 25

				flowcontainer = {
					margin_top = 0
					margin_right = 0
					margin_left = 0
					#margin_bottom = 10

					direction = vertical
					parentanchor = left
					spacing = 1

					flag_icon = {
						size = { 138 96 }

						block "flag_definition" {
							texture = "[GetPlayer.GetFlag.GetMediumFlagTexture]"
							frame = "[GetPlayer.GetFlag.GetMediumFlagFrame]"
						}
						parentanchor = hcenter
					}

					textbox = {
						using = fontsize_large
						autoresize = yes
						raw_text = "#BOLD [GetPlayer.GetName]#!"
						align = Hcenter
						elide = right
						parentanchor = hcenter
					}
					divider_gold = {
					}

					flowcontainer = {
						margin_top = 0
						margin_right = 0
						margin_left = 0

						direction = vertical
						parentanchor = hcenter

						textbox = {
							using = fontsize_large
							autoresize = yes
							raw_text = "1 [GetPlayer.GetCustom('currency_ISO_4217')] ([GetPlayer.GetCustom('currency_symbol')]) = [GetPlayer.MakeScope.ScriptValue('money_value_rapported_inflation')|+D] @gold!"
							align = Hcenter
							elide = right
							parentanchor = center
						}

						textbox = {
							using = fontsize_large
							autoresize = yes
							raw_text = "1 [GetPlayer.GetCustom('currency_ISO_4217')] ([GetPlayer.GetCustom('currency_symbol')]) = #v [Market.GetOwner.MakeScope.ScriptValue('exchange_rate_for_international_trade_buy_market_panel')|+D] #! [Market.GetOwner.GetCustom('currency_ISO_4217')]([Market.GetOwner.GetCustom('currency_symbol')])"
							align = Hcenter
							elide = right
							parentanchor = center
						}
					}

					background = {
						using = entry_bg_simple
						margin = { 10 10 }
					}

					minimumsize = { 245 200 }
					maximumsize = { 245 200 }
				}
				flowcontainer = {
					margin_top = 0
					margin_right = 0
					margin_left = 0
					#margin_bottom = 10

					parentanchor = left
					spacing = 2

					direction = vertical

					flag_icon = {
						size = { 138 96 }

						block "flag_definition" {
							texture = "[Market.GetOwner.GetFlag.GetMediumFlagTexture]"
							frame = "[Market.GetOwner.GetFlag.GetMediumFlagFrame]"
						}

						parentanchor = center
					}

					textbox = {
						using = fontsize_large
						autoresize = yes
						raw_text = "#BOLD [Market.GetOwner.GetName]#!"
						align = Hcenter
						elide = right
						parentanchor = center

					}
					divider_gold = {
					}

					flowcontainer = {
						margin_top = 0
						margin_right = 0
						margin_left = 0

						direction = vertical
						parentanchor = hcenter

						textbox = {
							using = fontsize_large
							autoresize = yes
							raw_text = "1 [Market.GetOwner.GetCustom('currency_ISO_4217')]([Market.GetOwner.GetCustom('currency_symbol')]) = [Market.GetOwner.MakeScope.ScriptValue('money_value_rapported_inflation')|+D] #! [Market.GetOwner.GetCustom('monetary_system')]"
							align = Hcenter
							elide = right
							parentanchor = center
						}
						textbox = {
							using = fontsize_large
							autoresize = yes
							raw_text = "1 [Market.GetOwner.GetCustom('currency_ISO_4217')] ([Market.GetOwner.GetCustom('currency_symbol')]) = #v [Market.GetOwner.MakeScope.ScriptValue('exchange_rate_for_international_trade_buy_for_target_market_panel')|+D] #! [GetMetaPlayer.GetPlayedOrObservedCountry.GetCustom('currency_ISO_4217')] ([GetMetaPlayer.GetPlayedOrObservedCountry.GetCustom('currency_symbol')])"
							align = Hcenter
							elide = right
							parentanchor = center
						}
					}

					background = {
						using = entry_bg_simple
						margin = { 10 10 }
					}

					minimumsize = { 245 200 }
					maximumsize = { 245 200 }
				}
			}

			#currency_exchange_panel_visibility
			flowcontainer  = {
				margin_top = 0
				margin_right = 0
				margin_left = 0

				direction = vertical
				parentanchor = hcenter

				spacing = 10

				default_header = {
					blockoverride "text" {
						text = "exchange_currency"
					}
				}

				##player = ok -> buy_sell_good_visibility -> in_currency
				flowcontainer = {
					visible = "[GetScriptedGui('currency_exchange_panel_visibility').IsShown( GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
					margin_top = 0
					margin_right = 0
					margin_left = 0
					margin_bottom = 0

					direction = vertical
					parentanchor = hcenter


					#Market.GetOwner = ok
					flowcontainer  = {
						visible = "[GetScriptedGui('currency_exchange_panel_visibility').IsShown( GuiScope.SetRoot(Market.GetOwner.MakeScope).End)]"

						margin_top = 0
						margin_right = 0
						margin_left = 0

						direction = vertical
						parentanchor = hcenter

						spacing = 10

						#selection in_gold/in_currency only witch the global reference currency
						flowcontainer  = {
							visible = "[GetScriptedGui('is_global_monetary_reference_more_button_visibility').IsShown( GuiScope.SetRoot(Market.GetOwner.MakeScope).End)]"

							margin_top = 0
							margin_right = 0
							margin_left = 0

							spacing = 10

							direction = horizontal
							parentanchor = hcenter

							button_icon_square = {
								enabled = "[GetScriptedGui('has_gold_exchange_standard_tech_more_button_visibility').IsValid( GuiScope.SetRoot(GetPlayer.MakeScope ).End)]"

								name = "buy_in_currency_in_currency"
								size = { 250 40 }

								using = tooltip_below

								onclick = "[GetScriptedGui('sell_in_currency_on').Execute( GuiScope.SetRoot(GetPlayer.MakeScope ).End)]"
								textbox = {
									using = fontsize_large
									autoresize = yes
									text = "buy_in_currency_in_currency"
									parentanchor = vcenter|hcenter
									default_format = "#white #bold"
									align = hcenter
								}
							}
							button_icon_square = {
								enabled = "[GetScriptedGui('has_gold_standard_no_gold_exchange_standard_tech_market_panel_visibility').IsValid( GuiScope.SetRoot(GetPlayer.MakeScope ).End)]"

								name = "buy_in_gold_currency"
								size = { 250 40 }

								using = tooltip_below

								onclick = "[GetScriptedGui('sell_in_gold_on').Execute( GuiScope.SetRoot(GetPlayer.MakeScope ).End)]"
								textbox = {
									using = fontsize_large
									autoresize = yes
									text = "buy_in_gold_currency"
									default_format = "#white #bold"
									parentanchor = vcenter|hcenter
									align = hcenter
								}
							}
						}

						#currrrency selection
						flowcontainer  = {
							direction = vertical
							parentanchor = hcenter

							spacing = 10

							divider_decorative = { }

							flowcontainer  = {
								margin_top = 0
								margin_right = 0
								margin_left = 0
								margin_bottom = 0

								spacing = 75

								direction = horizontal

								parentanchor = hcenter

								dropdown_menu_standard = {
									parentanchor = hcenter

									blockoverride "dropdown_properties"
									{
										datamodel = "[GetGlobalList('dropdown_menu_currency')]"
									}

									blockoverride "dropdown_size"
									{
										size = { 400 40 }
									}
									blockoverride "dropdown_list_maxsize" {
										maximumsize = { 400 250 }
									}

									blockoverride "dropdown_active_item_properties"
									{
										text = "[Localize(Concatenate(GetPlayer.MakeScope.Var('currency_selection').GetFlagName,'_name'))]"
									}

									blockoverride "dropdown_button_dropdown"
									{
										button = {
											using = default_button_map_interaction
											size = { 400 40 }

											block "dropdown_item_properties"
											{
												raw_text = "#D Option#!"
											}

											default_format = "#clickable"

											onclick = "[GetScriptedGui('selection_changed_for_currency').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('currency_dropdown_option', MakeScopeFlag(Scope.GetFlagName)).End)]"
										}
									}

									blockoverride "dropdown_item_properties"
									{
										widget = {
											size = { 100% 100% }
											hbox = {
												layoutpolicy_horizontal = expanding
												align = left
												parentanchor = left
												textbox = {
													text = "[Localize(Concatenate(Scope.GetFlagName,'_name_list'))]"
													autoresize = yes
													margin_bottom = 5
													margin_left = 0
													align = left
													parentanchor = left
													using = fontsize_large
													fontsize = 17

												}
											}
										}
									}
								}
								button_icon_round_action = {
									name = "update_currency_liste"

									parentanchor = vcenter

									size = { 40 40 }
									onclick = "[GetScriptedGui('update_currency_liste').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
									#tooltip =  "bond_dinar"
									using = tooltip_below

									blockoverride "icon" {
										texture = "gfx/interface/buttons/button_icons/reset.dds"
									}
									blockoverride "icon_size" {
										size = { 120% 120% }
									}
								}
							}

							divider_decorative = { }
						}

						#interaction section
						flowcontainer  = {
							spacing = 10
							direction = vertical
							parentanchor = hcenter

							#in_gold
							flowcontainer  = {
								spacing = 10
								direction = vertical
								parentanchor = hcenter

								visible = "[GetScriptedGui('buy_sell_currency_in_gold_on_button_visibility').IsShown( GuiScope.SetRoot(GetPlayer.MakeScope).End)]"

								#dinar
								flowcontainer  = {
									margin_top = 10
									margin_right = 0
									margin_left = 0
									margin_bottom = 0

									visible = "[GetScriptedGui('choose_currency_type_dinar_visible').IsShown( GuiScope.SetRoot(GetPlayer.MakeScope).End)]"

									parentanchor = hcenter
									direction = vertical

									spacing = 10

									#Presentation
									flowcontainer  = {
										margin_top = 0
										margin_right = 0
										margin_left = 15
										margin_bottom = 0

										spacing = 10

										direction = vertical

										parentanchor = hcenter

										#icon
										flowcontainer  = {
											margin_top = 10
											margin_right = 0
											margin_left = 0
											margin_bottom = 0

											parentanchor = hcenter

											widget = {
												size = { 1 10 }

												flowcontainer  = {
													margin_top = 0
													margin_right = 0
													margin_left = 0
													margin_bottom = 0
													parentanchor = left

													position = { 237 35 }

													textbox = {
														raw_text = "⇆"
														autoresize = yes
														align = nobaseline
														margin_left = 0
														margin_bottom = 0
														using = fontsize_large
														default_format = "#white #bold"
														fontsize = 50

													}
												}
											}

											flowcontainer  = {
												margin_top = 0
												margin_right = 0
												margin_left = 0
												margin_bottom = 0

												spacing = 20

												direction = horizontal

												flowcontainer  = {
													margin_top = 0
													margin_right = 0
													margin_left = 0
													margin_bottom = 0

													#metal
													flowcontainer  = {
														margin_top = 0
														margin_right = 0
														margin_left = 125
														margin_bottom = 0

														spacing = 5

														direction = vertical

														button_icon_round_big = {
															size = { 100 100 }

															visible = "[GetScriptedGui('law_dinar_monetary_system_GS_BS_GES_visible').IsShown( GuiScope.SetRoot(GetPlayer.MakeScope).End)]"

															blockoverride "icon" {
																texture = "gfx/interface/icons/goods_icons/gold.dds"
															}

															parentanchor = hcenter
															align = hcenter|nobaseline
														}
														button_icon_round_big = {
															size = { 100 100 }

															visible = "[GetScriptedGui('law_dinar_monetary_system_SS_visible').IsShown( GuiScope.SetRoot(GetPlayer.MakeScope).End)]"

															blockoverride "icon" {
																texture = "gfx/interface/icons/goods_icons/silver.dds"
															}

															parentanchor = hcenter
															align = hcenter|nobaseline
														}

														textbox = {
															text = "[GetPlayer.GetCustom('monetary_system_partiel_name_dinar')]"
															autoresize = yes
															align = hcenter
															parentanchor = hcenter
															using = fontsize_large
														}
													}
													background = {
														using = entry_bg_simple
														margin = { 10 10 }
													}
													minimumsize = { 250 40 }
													maximumsize = { 250 -1 }
												}

												#dinar
												flowcontainer  = {
													margin_top = 0
													margin_right = 0
													margin_left = 0
													margin_bottom = 0

													flowcontainer  = {
														margin_top = 0
														margin_right = 0
														margin_left = 125
														margin_bottom = 0

														spacing = 5

														direction = vertical

														button_icon_round_big = {
															size = { 100 100 }

															blockoverride "icon" {
																texture = "gfx/interface/icons/goods_icons/currencies/dinar.dds"
															}
															parentanchor = hcenter
															align = hcenter|nobaseline
														}

														textbox = {
															text = "dinar_c"
															autoresize = yes
															align = hcenter
															parentanchor = hcenter
															using = fontsize_large
															elide = right
															minimumsize = { 150 1 }
															maximumsize = { 150 -1 }
														}
													}
													background = {
														using = entry_bg_simple
														margin = { 10 10 }
													}

													minimumsize = { 250 40 }
													maximumsize = { 250 -1 }
												}

											}
										}

										#1th line
										flowcontainer = {

											margin_top = 10
											margin_right = 0
											margin_left = 0
											margin_bottom = 0

											spacing = 20

											direction = horizontal

											parentanchor = hcenter
											flowcontainer = {
												margin_top = 0
												margin_right = 0
												margin_left = 0
												margin_bottom = 0

												spacing = 5

												direction = vertical

												parentanchor = left

												textbox = {
													using = fontsize_large
													autoresize = yes
													raw_text = "[GetPlayer.GetCustom('monetary_system_partiel_name_dinar')] [GetPlayer.GetCustom('monetary_system_partiel_dinar')] owned in the central bank"

													parentanchor = hcenter
													align = hcenter|nobaseline
													margin_right = 0
													margin_bottom = 0
													multiline = yes

													minimumsize = { 250 40 }
													maximumsize = { 250 -1 }

												}

												#gold
												textbox = {
													using = fontsize_large
													autoresize = yes

													visible = "[GetScriptedGui('law_dinar_monetary_system_GS_BS_GES_visible').IsShown( GuiScope.SetRoot(GetPlayer.MakeScope).End)]"

													raw_text = "#T [GetPlayer.MakeScope.ScriptValue('gold_state_native_for_stockpile')|D]#! [GetPlayer.GetCustom('monetary_system_partiel_dinar')]"

													#ilkfaut afficher soit silver soit gold en fonction du type de la devise


													margin_left = 0
													parentanchor = hcenter
													align = hcenter|nobaseline

													margin_right = 0
													margin_bottom = 0
												}

												#silver
												textbox = {
													using = fontsize_large
													autoresize = yes

													visible = "[GetScriptedGui('law_dinar_monetary_system_SS_visible').IsShown( GuiScope.SetRoot(GetPlayer.MakeScope).End)]"

													raw_text = "#T [GetPlayer.MakeScope.ScriptValue('silver_state_native_for_stockpile')|D]#! [GetPlayer.GetCustom('monetary_system_partiel_dinar')]"

													#ilkfaut afficher soit silver soit gold en fonction du type de la devise


													margin_left = 0
													parentanchor = hcenter
													align = hcenter|nobaseline

													margin_right = 0
													margin_bottom = 0
												}

												background = {
													using = entry_bg_simple
													margin = { 10 5 }
												}
												minimumsize = { 250 90 }
												maximumsize = { 300 -1 }
											}

											flowcontainer = {
												margin_top = 0
												margin_right = 0
												margin_left = 0
												margin_bottom = 0

												spacing = 5

												direction = vertical

												parentanchor = left

												textbox = {
													using = fontsize_large
													autoresize = yes
													raw_text = "[GetPlayer.GetCustom('monetary_system_partiel_name_dinar')] [GetPlayer.GetCustom('monetary_system_partiel_dinar')] owned by market owner"

													parentanchor = hcenter
													align = hcenter|nobaseline
													margin_right = 0
													margin_bottom = 0
													multiline = yes

													minimumsize = { 250 40 }
													maximumsize = { 250 -1 }

												}

												#gold
												textbox = {
													using = fontsize_large
													autoresize = yes

													visible = "[GetScriptedGui('law_dinar_monetary_system_GS_BS_GES_visible').IsShown( GuiScope.SetRoot(GetPlayer.MakeScope).End)]"

													raw_text = "#T [Market.GetOwner.MakeScope.ScriptValue('gold_state_native_for_stockpile')|D]#! [GetPlayer.GetCustom('monetary_system_partiel_dinar')]"

													#ilkfaut afficher soit silver soit gold en fonction du type de la devise


													margin_left = 0
													parentanchor = hcenter
													align = hcenter|nobaseline

													margin_right = 0
													margin_bottom = 0
												}

												#silver
												textbox = {
													using = fontsize_large
													autoresize = yes

													visible = "[GetScriptedGui('law_dinar_monetary_system_SS_visible').IsShown( GuiScope.SetRoot(GetPlayer.MakeScope).End)]"

													raw_text = "#T [Market.GetOwner.MakeScope.ScriptValue('silver_state_native_for_stockpile')|D]#! [GetPlayer.GetCustom('monetary_system_partiel_dinar')]"

													#ilkfaut afficher soit silver soit gold en fonction du type de la devise


