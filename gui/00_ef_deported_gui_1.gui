							raw_text = " #variable [GetMetaPlayer.GetPlayedOrObservedCountry.GetCustom('currency_symbol')][GetPlayer.GetGoldReserves|K]#!"
							parentanchor = right|vcenter
							align = right|nobaseline
							margin_right = 20
						}
					}
				}
			}

