############################################################################################################################################################
############################################################################################################################################################
############################################################################################################################################################
############################################################################################################################################################

types market_states_panel
{
	type country_panel_currency_panel_content = flowcontainer {
		#margin_top = 10
		direction = vertical
		using = default_list_position
		spacing = 5

		##CURRENCY ### law_silver_standard_visibility
		country_stats_entry = {
			visible = "[GetScriptedGui('law_silver_standard_country_top_bar').IsShown( GuiScope.SetRoot(Country.MakeScope).End)]"
			tooltip = "MONEY_VALUE_silver_standard"

			currency_symbol_country_panel = {}

			blockoverride "stats_label" {
				text = "COUNTRY_CURRENCY_ONE_LINE"
			}
			blockoverride "information_icon" {
				#texture = "gfx/interface/buttons/button_icons/foreign_invest.dds"
			}
			blockoverride "stats_value" {
				raw_text = "#v [Country.GetCustom('currency_name')] ([Country.MakeScope.ScriptValue('money_value_rapported_inflation')|2] @silver!) #!"
				fontsize = 17
				#autoresize = yes
			}
		}

		##CURRENCY ### law_bimetallism_standard_visibility
		country_stats_entry = {
			visible = "[GetScriptedGui('law_bimetallism_standard_country_top_bar').IsShown( GuiScope.SetRoot(Country.MakeScope).End)]"
			tooltip = "MONEY_VALUE_bimetallism_standard"
			currency_symbol_country_panel = {}

			blockoverride "stats_label" {
				text = "COUNTRY_CURRENCY_ONE_LINE"
			}
			blockoverride "information_icon" {
				#texture = "gfx/interface/buttons/button_icons/foreign_invest.dds"
			}
			blockoverride "stats_value" {
				raw_text = "#v [Country.GetCustom('currency_name')] ([Country.MakeScope.ScriptValue('money_value_rapported_inflation')|2] @bimetallism!) #!"
				fontsize = 17
				#autoresize = yes
			}
		}

		##CURRENCY ### law_gold_standard_visibility
		country_stats_entry = {
			visible = "[GetScriptedGui('law_gold_standard_country_top_bar').IsShown( GuiScope.SetRoot(Country.MakeScope).End)]"
			tooltip = "MONEY_VALUE_gold_standard"
			currency_symbol_country_panel = {}

			blockoverride "stats_label" {
				text = "COUNTRY_CURRENCY_ONE_LINE"
			}
			blockoverride "information_icon" {
				#texture = "gfx/interface/buttons/button_icons/foreign_invest.dds"
			}
			blockoverride "stats_value" {
				raw_text = "#v [Country.GetCustom('currency_name')] ([Country.MakeScope.ScriptValue('money_value_rapported_inflation')|2] @gold!) #!"
				fontsize = 17
				#autoresize = yes
			} 
		}

		##CURRENCY	### law_gold_exchange_standard_visibility
		country_stats_entry = {
			visible = "[GetScriptedGui('law_gold_exchange_standard_country_top_bar').IsShown( GuiScope.SetRoot(Country.MakeScope).End)]"
			tooltip = "MONEY_VALUE_gold_exchange_standard"
			currency_symbol_country_panel = {}

			blockoverride "stats_label" {
				text = "COUNTRY_CURRENCY_ONE_LINE"
			}
			blockoverride "information_icon" {
				#texture = "gfx/interface/buttons/button_icons/foreign_invest.dds"
			}
			blockoverride "stats_value" {
				raw_text = "#v [Country.GetCustom('currency_name')] ([Country.MakeScope.ScriptValue('money_value_exchange_rate_with_reference_currency')|2] [Country.GetCustom('global_monetary_reference_texture')])"
				fontsize = 17
				#autoresize = yes
			}
		}

		##CURRENCY ### subject_country
		country_stats_entry = {
			visible = "[GetScriptedGui('subject_country_country_top_bar').IsShown( GuiScope.SetRoot(Country.MakeScope).End)]"
			tooltip = "MONEY_VALUE_subject"
			currency_symbol_country_panel = {}

			blockoverride "stats_label" {
				text = "COUNTRY_CURRENCY_ONE_LINE"
			}
			blockoverride "information_icon" {
				#texture = "gfx/interface/buttons/button_icons/foreign_invest.dds"
			}
			blockoverride "stats_value" {
				raw_text = "#v [Country.GetCustom('currency_name')] ([Country.MakeScope.ScriptValue('money_value_raported_to_overrlord')|2] [Country.GetCustom('overlord_currency_symbol')]) #!"
				fontsize = 17
				#autoresize = yes
			}
		}
	}
}

