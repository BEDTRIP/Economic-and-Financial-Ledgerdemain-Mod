############################################################################################################################################################
############################################################################################################################################################
############################################################################################################################################################
############################################################################################################################################################

types market_states_panel
{
	type budget_panel_stockpile_panel_content = flowcontainer {
		#margin_top = 10
		direction = vertical
		using = default_list_position
		spacing = 5

		### stockpile
		flowcontainer = {
			using = default_content_fade
			direction = vertical
			using = default_list_position
			spacing = 10
   
			############################################################################################################################################################
			############################################################################################################################################################
			############################################################################################################################################################
			############################################################################################################################################################

			############################################################################################################################################################
			############################################################################################################################################################
			############################################################################################################################################################
			############################################################################################################################################################
 
			default_header = {
				blockoverride "text" {
					text = "NATIONAL_STOKPILE_TITLE"
				}
			}

			#has_tech_national_stockpile
			flowcontainer = {
				margin_top = 0
				margin_right = 0
				margin_left = 0

				visible = "[GetScriptedGui('has_tech_national_stockpile').IsShown( GuiScope.SetRoot(GetPlayer.MakeScope).End)]"

				direction = vertical
				parentanchor = left

				spacing = 5

				flowcontainer  = {
					margin_top = 0
					margin_right = 0
					margin_left = 15

					direction = horizontal
					#parentanchor = hcenter

					spacing = 5

					icon = {
						position = { 0 0 }
						size = { 200 200 }
						texture = "gfx/interface/icons/building_icons/national_stockpile/national_stockpile.dds"

					}

					textbox = {
						text = "national_stockpile_country_desc"

						align = left|nobaseline
						elide = right
						default_format = "#white #bold"
						autoresize = yes
						fontsize = 19
						multiline = yes
						minimumsize = { 100 40 }
						maximumsize = { 335 -1 }
						allow_outside = yes
					}
				}
			}
			#not_has_tech_national_stockpile
			flowcontainer = {
				visible = "[GetScriptedGui('not_has_tech_national_stockpile').IsShown( GuiScope.SetRoot(GetPlayer.MakeScope).End)]"

				using = default_content_fade
				direction = vertical
				using = default_list_position
				spacing = 10

				textbox = {
					text = "you_must_have_the_technology_stockpiling_goods"
					autoresize = yes
					align = hcenter
					parentanchor = hcenter
					using = fontsize_large
					fontsize = 25
				}


			}
			#not_has_tech_national_stockpile_and_subject
			flowcontainer = {
				visible = "[GetScriptedGui('not_has_tech_national_stockpile_and_subject').IsShown( GuiScope.SetRoot(GetPlayer.MakeScope).End)]"

				using = default_content_fade
				direction = vertical
				using = default_list_position
				spacing = 10

				textbox = {
					text = "not_has_tech_national_stockpile_and_subject"
					autoresize = yes
					align = hcenter
					parentanchor = hcenter
					using = fontsize_large
					fontsize = 25
				}


			}
			#has_tech_national_stockpile_and_subject
			flowcontainer = {
				visible = "[GetScriptedGui('has_tech_national_stockpile_and_subject').IsShown( GuiScope.SetRoot(GetPlayer.MakeScope).End)]"

				using = default_content_fade
				direction = vertical
				using = default_list_position
				spacing = 10

				textbox = {
					text = "has_tech_national_stockpile_and_subject"
					autoresize = yes
					align = hcenter
					parentanchor = hcenter
					using = fontsize_large
					fontsize = 25
				}
			}

			############################################################################################################################################################
			############################################################################################################################################################
			############################################################################################################################################################
			############################################################################################################################################################

			############################################################################################################################################################
			############################################################################################################################################################
			############################################################################################################################################################
			############################################################################################################################################################

			default_header = {
				blockoverride "text" {
					text = "raw_material"
				}
				visible = "[GetScriptedGui('has_tech_national_stockpile').IsShown( GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
			}

			flowcontainer  = {
				margin_top = 0
				margin_right = 0
				margin_left = 0
				visible = "[GetScriptedGui('has_tech_national_stockpile').IsShown( GuiScope.SetRoot(GetPlayer.MakeScope).End)]"

				direction = horizontal
				parentanchor = hcenter

				spacing = 30
 
				flowcontainer  = {
					margin_top = 0
					margin_right = 0
					margin_left = 0

					spacing = 5

					direction = vertical

					# textbox = {
					# 	text = "budget_panel_desc_goods"
					# 	visible = "[GetScriptedGui('has_national_stockpile').IsShown( GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
					# 	autoresize = yes
					# 	parentanchor = Hcenter
					# 	align = Hcenter
					# 	using = fontsize_large

					# 	multiline = yes
					# 	maximumsize = { 500 -1 }
					# 	margin_bottom = 5
					# }

					# block "divider" {
					# 	divider_gold = {
					# 	}
					# }

					flowcontainer  = {
						visible = "[GetScriptedGui('has_national_stockpile').IsShown( GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
						margin_top = 0
						margin_right = 0
						margin_left = 0

						spacing = 25

						direction = vertical
						parentanchor = hcenter


						#selection
						flowcontainer  = {

							margin_top = 0
							margin_right = 0
							margin_left = 0

							spacing = 1

							direction = vertical
							parentanchor = hcenter

							flowcontainer  = {

								margin_top = 0
								margin_right = 0
								margin_left = 0

								spacing = 1

								direction = horizontal
								parentanchor = hcenter

								#grain
								button_icon_round_big = {
									size = { 55 55 }

									blockoverride "icon" {
										texture = "gfx/interface/icons/goods_icons/grain.dds"
									}

									onclick = "[GetScriptedGui('trade_grain_budget_panel').Execute( GuiScope.SetRoot(GetPlayer.MakeScope).End)]"

									onrightclick = "[RightClickMenuManager.ShowForGoods(Goods.AccessSelf)]"

