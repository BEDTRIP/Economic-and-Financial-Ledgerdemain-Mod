			divider_gold = {
				visible = "[GetScriptedGui('has_financial_center_tech_visibility').IsShown( GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
			}

			flowcontainer = {
				visible = "[GetScriptedGui('has_financial_center_tech_visibility').IsShown( GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
				margin_top = 0
				margin_right = 0
				margin_left = 0

				direction = vertical
				parentanchor = hcenter

				spacing = 5

				#info_finance_main
				section_header_button = {
					#visible = "[Not(IsDataModelEmpty(AccessPlayer.GetAvailableCompanies))]"

					blockoverride "left_text" {
						text = "info_finance_main"
					}

					blockoverride "onclick" {
						onclick = "[GetVariableSystem.Toggle('info_finance_main')]"
						onclick = "[GetScriptedGui('info_finance_main_list_gerenation_ordered').Execute( GuiScope.SetRoot(GetPlayer.MakeScope).End)]"

					}

					blockoverride "onclick_showmore" {
						visible = "[Not(GetVariableSystem.Exists('info_finance_main'))]"
					}

					blockoverride "onclick_showless" {
						visible = "[GetVariableSystem.Exists('info_finance_main')]"
					}
				}

				flowcontainer = {
					using = default_list_position
					direction = vertical
					visible = "[GetVariableSystem.Exists('info_finance_main')]"
					margin_top = 10
					margin_bottom = 10

					flowcontainer = {
						spacing = 25
						margin_left = 5
						direction = vertical

						flowcontainer = {
							spacing = 25
							direction = horizontal

							#country_indice
							flowcontainer = {
								spacing = 5
								direction = vertical

								textbox = {
									autoresize = yes
									text = "country_indice"
									align = nobaseline
									parentanchor = Hcenter
									fontsize = 15
									multiline = yes
									minimumsize = { 100 40 }
									maximumsize = { 100 -1 }
								}

								textbox = {
									autoresize = yes
									text = "[GetPlayer.MakeScope.ScriptValue('country_indice')|+D] [GetPlayer.GetCustom('global_monetary_reference_texture')]"
									align = nobaseline
									parentanchor = Hcenter
									fontsize = 20
								}

								background = {
									using = entry_bg_simple
									margin = { 10 10 }
								}

								minimumsize = { 100 95 }
								maximumsize = { 100 -1 }
							}

							#bond_market_index
							flowcontainer = {
								spacing = 5
								direction = vertical

								textbox = {
									autoresize = yes
									text = "bond_market_index"
									align = hcenter
									parentanchor = hcenter
									multiline = yes
									fontsize = 15

									minimumsize = { 100 40 }
									maximumsize = { 100 -1 }
								}

								textbox = {
									autoresize = yes
									text = "[GetPlayer.MakeScope.ScriptValue('bond_market_index')|+D] [GetPlayer.GetCustom('global_monetary_reference_texture')]"
									align = nobaseline
									parentanchor = hcenter
									fontsize = 20
								}

								background = {
									using = entry_bg_simple
									margin = { 10 10 }
								}

								minimumsize = { 100 95 }
								maximumsize = { 100 -1 }
							}

							#manufacture_stock_index
							flowcontainer = {
								spacing = 5
								margin_left = 50
								direction = vertical

								textbox = {
									autoresize = yes
									text = "manufacture_stock_index"
									align = nobaseline
									parentanchor = hcenter
									multiline = yes
									fontsize = 15
									minimumsize = { 100 40 }
