														text = "[Country.GetName]"

														margin_left = 5
														margin_bottom = 1
														elide = right
														align = left|nobaseline
														parentanchor = left|nobaseline
														alwaystransparent = yes
													}

													vertical_divider = {}

													textbox = {

														layoutstretchfactor_horizontal = 1.75
														layoutpolicy_horizontal = preferred
														datacontext = "[Scope.GetCountry]"

														text = "opium_name"

														margin_left = 8

														margin_left = 5
														margin_bottom = 1
														elide = right
														align = left|nobaseline
														parentanchor = left|nobaseline
														alwaystransparent = yes
													}

													vertical_divider = {}

													textbox = {

														layoutstretchfactor_horizontal = 1.75
														layoutpolicy_horizontal = preferred
														datacontext = "[Scope.GetCountry]"

														text = "[GetPlayer.MakeScope.Var('opium_sell_1').GetValue|+D] @opium!"

														margin_left = 10
														margin_bottom = 1
														elide = right
														align = left|nobaseline
														parentanchor = left|nobaseline
														alwaystransparent = yes
													}


													vertical_divider = {}

													textbox = {
														layoutstretchfactor_horizontal = 1
														layoutpolicy_horizontal = preferred
														datacontext = "[Scope.GetCountry]"


														text = "[GetPlayer.MakeScope.Var('opium_sell_price').GetValue|+D] [Country.GetCustom('currency_symbol')]"

														margin_left = 25
														margin_bottom = 1
														elide = right
														align = left|nobaseline
														parentanchor = left|nobaseline
														alwaystransparent = yes
													}

													vertical_divider = {}

													textbox = {
														layoutstretchfactor_horizontal = 1.5
														layoutpolicy_horizontal = preferred
														datacontext = "[Scope.GetCountry]"

														text = "[GetPlayer.MakeScope.Var('opium_sell_price_by_price').GetValue|+D] [Country.GetCustom('currency_good')]"

														margin_left = 10
														margin_bottom = 1
														elide = right
														align = left|nobaseline
														parentanchor = left|nobaseline
														alwaystransparent = yes
													}

													vertical_divider = {}


													textbox = {
														layoutstretchfactor_horizontal = 1.75
														layoutpolicy_horizontal = preferred


														datacontext = "[Scope.GetCountry]"

														text = "[GetPlayer.GetCustom('sell_opium_1')]"

														margin_left = 12


														margin_left = 5
														margin_bottom = 1
														elide = right
														align = left|nobaseline
														parentanchor = left|nobaseline
														alwaystransparent = yes
													}
												}
											}
										}
									} 
								}
							}
						}
					}

					#Market.GetOwner = no ok
					flowcontainer = {
						visible = "[GetScriptedGui('no_buy_sell_good_visibility').IsShown( GuiScope.SetRoot(Market.GetOwner.MakeScope).End)]"
						margin_top = 0
						margin_right = 0
						margin_left = 0
						margin_bottom = 0

						direction = vertical
						parentanchor = hcenter

						spacing = 10
						textbox = {
							text = "market_owner_no_buy_sell_good_visibility"
							autoresize = yes
							align = hcenter
							parentanchor = hcenter
							using = fontsize_large
						}
					}
				}

				#player = no ok
				flowcontainer = {
					visible = "[GetScriptedGui('no_buy_sell_good_visibility').IsShown( GuiScope.SetRoot(GetPlayer.MakeScope).End)]"

					using = default_content_fade
					direction = vertical
					using = default_list_position
					spacing = 10

					textbox = {
						text = "player_no_buy_sell_good_visibility"
						autoresize = yes
						align = hcenter
						parentanchor = hcenter
						using = fontsize_large
					}
				} 
			}
		}
	}
}

