													}
												}
											}
										}
									}

								}
							}
						}
						############################################################################################################################################################
					}
					#Market.GetOwner = no ok
					flowcontainer = {
						visible = "[GetScriptedGui('no_has_financial_center_market_panel_visibility').IsShown( GuiScope.SetRoot(Market.GetOwner.MakeScope).End)]"

						using = default_content_fade
						direction = vertical
						using = default_list_position
						spacing = 10

						textbox = {
							text = "market_owner_no_has_financial_center"
							autoresize = yes
							align = hcenter
							parentanchor = hcenter
							using = fontsize_large
						}
					}
				}

				#player = no ok
				flowcontainer = {
					visible = "[GetScriptedGui('no_has_financial_center_market_panel_visibility').IsShown( GuiScope.SetRoot(GetPlayer.MakeScope).End)]"

					using = default_content_fade
					direction = vertical
					using = default_list_position
					spacing = 10

					textbox = {
						text = "player_no_has_financial_center"
						autoresize = yes
						align = hcenter
						parentanchor = hcenter
						using = fontsize_large
					}
				}

			}
		}
	}
}

