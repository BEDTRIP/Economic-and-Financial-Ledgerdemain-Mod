						#currency_reserves
						section_header_button = {
							#visible = "[Not(IsDataModelEmpty(AccessPlayer.GetAvailableCompanies))]"

							blockoverride "left_text" {
								text = "currency_reserves_panel"
							}

							blockoverride "onclick" {
								onclick = "[GetVariableSystem.Toggle('currency_reserves')]"
								onclick = "[GetScriptedGui('update_currency_stored_liste').Execute( GuiScope.SetRoot(GetPlayer.MakeScope).End)]"

							}

							blockoverride "onclick_showmore" {
								visible = "[Not(GetVariableSystem.Exists('currency_reserves'))]"
							}

							blockoverride "onclick_showless" {
								visible = "[GetVariableSystem.Exists('currency_reserves')]"
							}
						}
						flowcontainer = {
							using = default_list_position
							visible = "[GetVariableSystem.Exists('currency_reserves')]"

							margin_top = 25
							margin_right = -75
							margin_left = 75
							margin_bottom = 10

							parentanchor = left|nobaseline

							dynamicgridbox = {
								datamodel = "[GetGlobalList('stored_currency')]"

								flipdirection = yes
								datamodel_wrap = 4

								parentanchor = left|nobaseline

								position = { 0 0 }

								item = {
									flowcontainer = {
										margin_top = 0
										margin_right = 0
