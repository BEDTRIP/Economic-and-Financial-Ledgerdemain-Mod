types market_states_panel
{
	type state_panel_currency_panel_content = flowcontainer {
		#margin_top = 10
		direction = vertical
		using = default_list_position
		spacing = 5

		flowcontainer = {
			spacing = 10
			margin_top = 10
			margin_left = 20

			direction = vertical

			#recently looted
			flowcontainer = {
				visible = "[GetScriptedGui('is_looted_state').IsShown( GuiScope.SetRoot( State.MakeScope ).End)]"
				spacing = 0
				margin_top = 10
				margin_bottom = 10

				parentanchor = hcenter

				direction = horizontal

				background = {
					using = entry_bg_simple
					margin = { 50 5 }
				}

				textbox = {
					text = "is_looted_state"
					align = hcenter
					elide = right
					default_format = "#white #bold"
					autoresize = yes
					fontsize = 20
					allow_outside = yes
				}
			}
			#loot
			flowcontainer = {
				visible = "[GetScriptedGui('transfert_loot_state').IsShown( GuiScope.SetRoot( State.MakeScope ).End)]"
				spacing = 0
				margin_top = 10
				margin_bottom = 5

				parentanchor = hcenter

				direction = horizontal

				background = {
					using = entry_bg_simple
					margin = { 50 5 }
				}

				#trransfert
				flowcontainer = {
					spacing = 0

					parentanchor = hcenter
					direction = vertical

					button_icon_square = {
						name = "central_bank_metal_reserves_state_transfert"
						position = { -150 0 }

						size = { 150 60 }

						tooltip = "central_bank_metal_reserves_state_transfert"
						using = tooltip_below

						onclick = "[GetScriptedGui('stockpiling_central_bank_metal_reserves_state_transfert').Execute( GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
						enabled = "[GetScriptedGui('stockpiling_central_bank_metal_reserves_state_transfert_state').IsValid( GuiScope.SetRoot(State.MakeScope ).End)]"

						icon = {
							texture = "gfx/interface/icons/generic_icons/arrow_outbound.dds"
							size = { 100 100 }
							position = { 0 3 }
							parentanchor = hcenter|vcenter
						}
					}
					textbox = {
						using = fontsize_large
						text = "transfer"
						autoresize = yes
						align = hcenter
						parentanchor = hcenter
						default_format = "#white #bold"
						#fontsize = 40
					}
				}

				#looting
				flowcontainer = {
					spacing = 0
					parentanchor = hcenter

					direction = vertical

					button_icon_square = {
						name = "looting_state_button"
						position = { 0 0 }

						size = { 150 60 }

						tooltip =  "looting_state_button"
						using = tooltip_below

						onclick = "[GetScriptedGui('looting_state_button').Execute( GuiScope.SetRoot(State.MakeScope).End)]"
						enabled = "[GetScriptedGui('looting_state_button').IsValid( GuiScope.SetRoot(State.GetOwner.MakeScope).End)]"

						icon = {
							texture = "gfx/interface/icons/generic_icons/war_looting.dds"
							size = { 100 50 }
							position = { 0 0 }
							parentanchor = hcenter|vcenter
						}
					}
					textbox = {
						using = fontsize_large
						text = "pillage"
						autoresize = yes
						align = hcenter
						parentanchor = hcenter
						default_format = "#white #bold"
						#fontsize = 40
					}
				}
			}

			#economic
			flowcontainer = {
				spacing = 0
				margin_top = 10
				margin_bottom = 10

				parentanchor = hcenter
				visible = "[GetScriptedGui('central_bank_historic_place').IsShown( GuiScope.SetRoot( State.MakeScope ).End)]"
				direction = vertical

				background = {
					using = entry_bg_simple
				}

				widget = {
					size = { 520 200 }
