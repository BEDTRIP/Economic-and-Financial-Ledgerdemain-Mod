types market_states_panel
{
	type market_global_panel_content = flowcontainer {
		margin_top = 10
		direction = vertical
		using = default_list_position
		spacing = 5

		#not
		flowcontainer = {
			visible = "[GetScriptedGui('not_is_ai').IsShown( GuiScope.SetRoot(Market.GetOwner.MakeScope).End)]"

			using = default_content_fade
			direction = vertical
			using = default_list_position
			spacing = 10

			textbox = {
				text = "select_a_foreign_market"
				autoresize = yes
				align = hcenter
				parentanchor = hcenter
				using = fontsize_large
				fontsize = 40
			}
		}

		#yes
		flowcontainer = {
			visible = "[GetScriptedGui('is_ai').IsShown( GuiScope.SetRoot(Market.GetOwner.MakeScope).End)]"

			using = default_content_fade
			direction = vertical
			using = default_list_position
			spacing = 10

			default_header = {
				blockoverride "text" {
					text = "comparison_of_countries"
				}
			}

			#comparison_of_countries
			flowcontainer = {
				margin_top = 0
				margin_right = 0
				margin_left = 0
				margin_bottom = 10

				direction = horizontal
				parentanchor = hcenter

				spacing = 25

				flowcontainer = {
					margin_top = 0
					margin_right = 0
					margin_left = 0
					#margin_bottom = 10

					direction = vertical
					parentanchor = left
					spacing = 1

					flag_icon = {
						size = { 138 96 }

						block "flag_definition" {
							texture = "[GetPlayer.GetFlag.GetMediumFlagTexture]"
							frame = "[GetPlayer.GetFlag.GetMediumFlagFrame]"
						}
						parentanchor = hcenter
					}

					textbox = {
						using = fontsize_large
						autoresize = yes
						raw_text = "#BOLD [GetPlayer.GetName]#!"
						align = Hcenter
						elide = right
						parentanchor = hcenter
					}
					divider_gold = {
					}

					flowcontainer = {
						margin_top = 0
						margin_right = 0
						margin_left = 0

						direction = vertical
						parentanchor = hcenter

						textbox = {
							using = fontsize_large
							autoresize = yes
							raw_text = "1 [GetPlayer.GetCustom('currency_ISO_4217')] ([GetPlayer.GetCustom('currency_symbol')]) = [GetPlayer.MakeScope.ScriptValue('money_value_rapported_inflation')|+D] @gold!"
							align = Hcenter
							elide = right
							parentanchor = center
						}

						textbox = {
							using = fontsize_large
							autoresize = yes
							raw_text = "1 [GetPlayer.GetCustom('currency_ISO_4217')] ([GetPlayer.GetCustom('currency_symbol')]) = #v [Market.GetOwner.MakeScope.ScriptValue('exchange_rate_for_international_trade_buy_market_panel')|+D] #! [Market.GetOwner.GetCustom('currency_ISO_4217')]([Market.GetOwner.GetCustom('currency_symbol')])"
							align = Hcenter
							elide = right
							parentanchor = center
						}
					}

					background = {
						using = entry_bg_simple
						margin = { 10 10 }
					}

					minimumsize = { 245 200 }
					maximumsize = { 245 200 }
				}
				flowcontainer = {
					margin_top = 0
					margin_right = 0
					margin_left = 0
					#margin_bottom = 10

					parentanchor = left
					spacing = 2

					direction = vertical

					flag_icon = {
						size = { 138 96 }

						block "flag_definition" {
							texture = "[Market.GetOwner.GetFlag.GetMediumFlagTexture]"
							frame = "[Market.GetOwner.GetFlag.GetMediumFlagFrame]"
						}

						parentanchor = center
					}

					textbox = {
						using = fontsize_large
						autoresize = yes
						raw_text = "#BOLD [Market.GetOwner.GetName]#!"
						align = Hcenter
						elide = right
						parentanchor = center

					}
					divider_gold = {
					}

					flowcontainer = {
						margin_top = 0
						margin_right = 0
						margin_left = 0

						direction = vertical
						parentanchor = hcenter

						textbox = {
							using = fontsize_large
							autoresize = yes
							raw_text = "1 [Market.GetOwner.GetCustom('currency_ISO_4217')]([Market.GetOwner.GetCustom('currency_symbol')]) = [Market.GetOwner.MakeScope.ScriptValue('money_value_rapported_inflation')|+D] #! [Market.GetOwner.GetCustom('monetary_system')]"
							align = Hcenter
							elide = right
							parentanchor = center
						}
						textbox = {
							using = fontsize_large
							autoresize = yes
							raw_text = "1 [Market.GetOwner.GetCustom('currency_ISO_4217')] ([Market.GetOwner.GetCustom('currency_symbol')]) = #v [Market.GetOwner.MakeScope.ScriptValue('exchange_rate_for_international_trade_buy_for_target_market_panel')|+D] #! [GetMetaPlayer.GetPlayedOrObservedCountry.GetCustom('currency_ISO_4217')] ([GetMetaPlayer.GetPlayedOrObservedCountry.GetCustom('currency_symbol')])"
							align = Hcenter
							elide = right
							parentanchor = center
						}
					}

					background = {
						using = entry_bg_simple
						margin = { 10 10 }
					}

					minimumsize = { 245 200 }
					maximumsize = { 245 200 }
				}
			}

			#purchase_of_bond_debt_visibility
			flowcontainer = {
				direction = vertical
				using = default_list_position
				spacing = 5

				default_header = {
					blockoverride "text" {
						text = "purchase_of_bond_debt"
					}
				}

				#player = ok
				flowcontainer = {
					visible = "[GetScriptedGui('has_financial_center_market_panel_visibility').IsShown( GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
					direction = vertical
					using = default_list_position
					spacing = 5

					#Market.GetOwner = ok
					flowcontainer = {
						visible = "[GetScriptedGui('has_financial_center_market_panel_visibility').IsShown( GuiScope.SetRoot(Market.GetOwner.MakeScope).End)]"

						margin_top = 0
						margin_right = 0
						margin_left = 0

						direction = vertical
						parentanchor = hcenter

						spacing = 5

						flowcontainer = {
							margin_top = 0
							margin_right = 0
							margin_left = 0

							direction = horizontal
							parentanchor = hcenter

							spacing = 30

							flowcontainer  = {
								margin_top = 0
								margin_right = 0
								margin_left = 0

								spacing = 10

								direction = vertical

								flowcontainer  = {
									margin_top = 0
									margin_right = 0
									margin_left = 0

									spacing = 25

									direction = horizontal

									parentanchor = hcenter

									flowcontainer  = {
										margin_top = 0
										margin_right = 0
										margin_left = 0
										margin_bottom = 0

										spacing = 5
										direction = vertical

										textbox = {
											using = fontsize_large
											autoresize = yes
											text = "country_rating"
											parentanchor = hcenter
											align = vcenter
											default_format = "#white #bold"
											fontsize = 30
										}
										textbox = {
											using = fontsize_large
											autoresize = yes
											text = "[Market.GetOwner.GetCustom('country_credit_rating_texture')]"
											parentanchor = hcenter
											elide = right
											align = hcenter|nobaseline
											fontsize = 75

										}
										textbox = {
											using = fontsize_large
											autoresize = yes
											text = "[Market.GetOwner.GetCustom('country_credit_rating_sentence_market')]"
											parentanchor = hcenter
											elide = right
											align = hcenter|nobaseline
											fontsize = 25
											multiline = yes
											maximumsize = { 500 -1 }

										}
									}
								}

								block "divider" {
									divider_gold = {
									}
								}

								#line 1
								flowcontainer  = {
									margin_top = 0
									margin_right = 0
									margin_left = 0
									margin_bottom = 0

									spacing = 25
									direction = horizontal
									parentanchor = hcenter


									flowcontainer  = {
										margin_top = 0
										margin_right = 0
										margin_left = 0
										margin_bottom = 0

										spacing = 1
										direction = vertical

										textbox = {
											using = fontsize_large
											autoresize = yes
											text = "remaining_debt"
											parentanchor = hcenter
											align = hcenter|nobaseline
											elide = right
											multiline = yes
											maximumsize = { 325 -1 }
										}
										textbox = {
											#text = "[Market.GetOwner.MakeScope.ScriptValue('remaining_debt')|+D] @gold!/[Market.GetOwner.MakeScope.ScriptValue('total_debt')|+D] @gold!"
											text = "[Market.GetOwner.MakeScope.ScriptValue('remaining_debt')|+D] [GetPlayer.GetCustom('monetary_system_partiel')]"

											default_format = "#white #bold"
											autoresize = yes
											parentanchor = hcenter
											align = hcenter|nobaseline
											fontsize = 35

										}

										background = {
											using = entry_bg_simple
											margin = { 10 5 }
										}
										minimumsize = { 150 60 }
										maximumsize = { 150 -1 }
									}
									flowcontainer  = {
										margin_top = 0
										margin_right = 0
										margin_left = 0
										margin_bottom = 0

										spacing = 1
										direction = vertical

										textbox = {
											using = fontsize_large
											autoresize = yes
											text = "[concept_base_interest_value_5Y]"
											parentanchor = hcenter
											align = hcenter|nobaseline
											elide = right
											fontsize = 17

											multiline = yes
											minimumsize = { 150 40 }
											maximumsize = { 150 -1 }
										}
										textbox = {
											text = "[Market.GetOwner.MakeScope.ScriptValue('interest_value_5Y')|=%]"

											default_format = "#white #bold"
