															parentanchor = left
															align = left|nobaseline
															margin_right = 0
															margin_bottom = 0
														}

														textbox = {
															using = fontsize_large
															autoresize = yes
															raw_text = "@opium!"

															parentanchor = left
															align = left|nobaseline
															margin_right = 0
															margin_bottom = 0
														}
													}

													textbox = {
														using = fontsize_large
														autoresize = yes
														raw_text = "[GetPlayer.MakeScope.ScriptValue('opium_release_quantity_1_month')|=-D] @opium!"

														margin_left = 0
														parentanchor = hcenter
														align = hcenter|nobaseline

														margin_right = 0
														margin_bottom = 0
													}

													background = {
														using = entry_bg_simple
														margin = { 10 5 }
													}
												}
												#1 week
												flowcontainer = {
													margin_top = 0
													margin_right = 0
													margin_left = 0
													margin_bottom = 0

													spacing = 5

													direction = vertical

													parentanchor = left

													flowcontainer = {
														margin_top = 0
														margin_right = 0
														margin_left = 0
														margin_bottom = 0

														spacing = 5

														direction = horizontal

														parentanchor = left

														textbox = {
															using = fontsize_large
															autoresize = yes
															text = "total_1_week"

															parentanchor = left
															align = left|nobaseline
															margin_right = 0
															margin_bottom = 0
														}

														textbox = {
															using = fontsize_large
															autoresize = yes
															raw_text = "@opium!"

															parentanchor = left
															align = left|nobaseline
															margin_right = 0
															margin_bottom = 0
														}
													}

													textbox = {
														using = fontsize_large
														autoresize = yes
														raw_text = "[GetPlayer.MakeScope.ScriptValue('opium_release_quantity_1_week')|=-D] @opium!"

														margin_left = 0
														parentanchor = hcenter
														align = hcenter|nobaseline

														margin_right = 0
														margin_bottom = 0
													}

													background = {
														using = entry_bg_simple
														margin = { 10 5 }
													}
												}
											}

											flowcontainer  = {
												margin_top = 0
												margin_right = 0
												margin_left = 0
												margin_bottom = 0

												spacing = 15

												direction = vertical
												parentanchor = hcenter


												flowcontainer = {
													margin_top = 0
													margin_right = 0
													#margin_left = 100
													margin_bottom = 0

													spacing = 0

													direction = horizontal

													parentanchor = hcenter

													flowcontainer  = {
														margin_top = 0
														margin_right = 0
														margin_left = 0
														margin_bottom = 0

														spacing = 15

														direction = vertical
														#parentanchor = hcenter


														textbox = {
															name = "opium_release_quantity"
															autoresize = yes
															raw_text = "[GetPlayer.MakeScope.Var('opium_release_quantity').GetValue|D] @opium!"
															#tooltip = "CENTRAL_BANK_INTEREST_EFFECT"
															align = hcenter
															parentanchor = hcenter
															fontsize = 50

															margin_left = 50
														}

														flowcontainer = {
															margin_top = 0
															margin_right = 0
															margin_left = 0
															margin_bottom = 0

															spacing = 20

															direction = vertical

															parentanchor = hcenter

															background = {
																using = entry_bg
																margin = { 10 5 }
															}

															flowcontainer = {
																margin_top = 0
																margin_right = 0
																margin_left = 0
																margin_bottom = 0

																spacing = 20

																direction = horizontal

																parentanchor = hcenter

																### DOWNSIZE
																button_icon_minus_action = {
																	name = "reduce_opium_quantity_release"
																	size = { 35 35 }
																	parentanchor = vcenter
																	tooltip = "reduce_opium_quantity_release"
																	onclick = "[GetScriptedGui('reduce_opium_quantity_release').Execute( GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
																	enabled = "[GetScriptedGui('reduce_opium_quantity_release').IsValid( GuiScope.SetRoot(GetPlayer.MakeScope ).End)]"
																	using = tooltip_below
																}
																textbox = {
																	autoresize = yes
																	text = "quantity_for_1_month"
																	align = nobaseline
																	parentanchor = vcenter
																}
																### EXPAND
																button_icon_plus_action = {
																	name = "increase_opium_quantity_release"
																	size = { 35 35 }
																	parentanchor = vcenter
																	tooltip = "increase_opium_quantity_release"
																	onclick = "[GetScriptedGui('increase_opium_quantity_release').Execute( GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
																	enabled = "[GetScriptedGui('increase_opium_quantity_release').IsValid( GuiScope.SetRoot(GetPlayer.MakeScope ).End)]"
																}
															}
														}
													}

													flowcontainer  = {
														margin_top = 0
														margin_right = 0
														margin_left = 0
														margin_bottom = 0

														spacing = 15

														direction = vertical
														#parentanchor = hcenter


														textbox = {
															name = "opium_release_month"
															autoresize = yes
															text = "[GetPlayer.MakeScope.Var('opium_release_month').GetValue]"
															#tooltip = "CENTRAL_BANK_INTEREST_EFFECT"
															align = hcenter
															parentanchor = hcenter
															fontsize = 50

															margin_left = 0
															margin_top = 5
														}

														flowcontainer = {
															margin_top = 0
															margin_right = 0
															margin_left = 0
															margin_bottom = 0

															spacing = 20

															direction = vertical

															parentanchor = hcenter

															background = {
																using = entry_bg
																margin = { 10 5 }
															}

															flowcontainer = {
																margin_top = 0
																margin_right = 0
																margin_left = 0
																margin_bottom = 0

																spacing = 20

																direction = horizontal

																parentanchor = hcenter

																### DOWNSIZE
																button_icon_minus_action = {
																	name = "reduce_opium_month_release"
																	size = { 35 35 }
																	parentanchor = vcenter
																	tooltip = "reduce_opium_month_release"
																	onclick = "[GetScriptedGui('reduce_opium_month_release').Execute( GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
																	enabled = "[GetScriptedGui('reduce_opium_month_release').IsValid( GuiScope.SetRoot(GetPlayer.MakeScope ).End)]"
																	using = tooltip_below
																}
																textbox = {
																	autoresize = yes
																	text = "month"
																	align = nobaseline
																	parentanchor = vcenter
																}
																### EXPAND
																button_icon_plus_action = {
																	name = "increase_opium_month_release"
																	size = { 35 35 }
																	parentanchor = vcenter
																	tooltip = "increase_opium_month_release"
																	onclick = "[GetScriptedGui('increase_opium_month_release').Execute( GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
																	enabled = "[GetScriptedGui('increase_opium_month_release').IsValid( GuiScope.SetRoot(GetPlayer.MakeScope ).End)]"
																}
															}
														}
													}

												}

												#bouton
												flowcontainer = {
													margin_top = 0
													margin_right = 0
													margin_left = 100
													margin_bottom = 0

													spacing = 10

													direction = horizontal

													parentanchor = hcenter



													button_icon_square = {
														name = "release_opium"

														size = { 138 40 }

														tooltip = "release_opium"
														using = tooltip_below

														#visible = "[GetScriptedGui('law_money_currency_visible').IsShown( GuiScope.SetRoot(GetPlayer.MakeScope).End)]"

														enabled = "[GetScriptedGui('set_release_opium_enabled').IsValid( GuiScope.SetRoot(GetPlayer.MakeScope ).End)]"
														onclick = "[GetScriptedGui('set_release_opium').Execute( GuiScope.SetRoot(GetPlayer.MakeScope ).End)]"
														textbox = {
															using = fontsize_large
															autoresize = yes
															text = "set_release"
															parentanchor = hcenter
															#default_format = "#white #bold"
															align = vcenter|nobaseline
															position = { 0 3 }
															fontsize = 25

														}
													}

													flowcontainer = {
														margin_top = 0
														margin_right = 0
														margin_left = 0
														margin_bottom = 0

														spacing = 10

														direction = horizontal


														button_icon_round_action = {
															name = "opium_release"

															size = { 40 40 }

															onclick = "[GetScriptedGui('release_opium_off').Execute( GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
															tooltip =  "opium_sell"
															using = tooltip_below


															blockoverride "icon" {
																texture = "gfx/interface/buttons/button_icons/reset.dds"
															}
															blockoverride "icon_size" {
																size = { 120% 120% }
															}

														}

														button_icon_round_action = {
															name = "set_opium_0"

															size = { 40 40 }
															onclick = "[GetScriptedGui('set_opium_0').Execute( GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
															enabled = "[GetScriptedGui('set_opium_0').IsValid( GuiScope.SetRoot(GetPlayer.MakeScope ).End)]"
															tooltip = "set_opium_0"

															blockoverride "icon" {
																texture = "gfx/interface/buttons/button_icons/reset_value_icon.dds"
															}
															blockoverride "icon_size" {
																size = { 60% 60% }
															}

														}
													}
												}
											} 
										}
									}  
								}
 
								divider_decorative = {
									#size = { 100% 100% }
								}
							}
						}  
					} 

					#overview	 
					section_header_button = {
						#visible = "[Not(IsDataModelEmpty(AccessPlayer.GetAvailableCompanies))]"

						blockoverride "left_text" {
							text = "stockpile_panel_overview_section"
						}

						blockoverride "onclick" {
							onclick = "[GetVariableSystem.Toggle('stockpile_panel_overview_section')]"
							onclick = "[GetScriptedGui('update_stocked_goods_global_variable_list').Execute( GuiScope.SetRoot(GetPlayer.MakeScope).End)]"

						}

						blockoverride "onclick_showmore" {
							visible = "[Not(GetVariableSystem.Exists('stockpile_panel_overview_section'))]"
						}

						blockoverride "onclick_showless" {
							visible = "[GetVariableSystem.Exists('stockpile_panel_overview_section')]"
						}
					}
					flowcontainer = {
						using = default_list_position
						direction = vertical
						visible = "[GetVariableSystem.Exists('stockpile_panel_overview_section')]"
  
						flowcontainer = {
							margin_right = 0
							margin_bottom = 0
							margin_left = 0

							direction = vertical
							parentanchor = hcenter

							spacing = 10
 
							flowcontainer = { 
								sort_button = {  
									size = { 77 20 } 
									button = {
										texture = "gfx/interface/buttons/sort_button_icons/sort_icon_good.dds"
										size = { 25 25 }
										parentanchor = center
										alwaystransparent = yes
									}
								}
								sort_button = {
									text = "quantity" 
									
									size = { 140 20 }
									align = hcenter|nobaseline
								}

								sort_button = {
									text = "stored" 
									size = { 105 20 }
									align = hcenter|nobaseline
								}

								sort_button = {
									text = "relesed" 
									size = { 105 20 }
									align = hcenter|nobaseline
								}

								sort_button = {
									text = "order" 
									size = { 110 20 }
									align = hcenter|nobaseline
								} 
							}	 

							flowcontainer = {
								direction = vertical
								datamodel = "[GetGlobalList('stocked_goods_global_variable_list')]"

								margin_top = 0
								margin_right = 0
								margin_left = 0
								margin_bottom = 0

								#spacing = 10

								item = {
									button = {
										using = default_button
										size = { @panel_width 55 } 
				

										hbox = {
											margin = { 12 0 } 

											datacontext = "[Scope.GetGoods]"

											widget = {
												layoutstretchfactor_horizontal = 1
												layoutpolicy_horizontal = preferred 


												block "widget_size" {
													size = { 55 55 }
												}

												icon = {
													texture = "gfx/interface/market_view/trade_good_list_bg.dds"
													block "goods_list_item_background_position" {
														position = { 25 0 }
													}

													block "goods_list_item_background_size" {
														size = { 120 46 }
													}

													parentanchor = vcenter
													color = "[Goods.GetCategoryColor]"
												}

												icon = {
													texture = "gfx/interface/market_view/trade_good_icon_bg.dds"
													color = "[Goods.GetCategoryColor]"

													block "bg_size" {
														size = { 55 55 }
													} 

													textbox = {  
														text = "[Localize(Concatenate(Scope.GetFlagName,'_icon'))]"
														parentanchor = center 
														#margin = { 0 10 }
														fontsize = 30 
														autoresize = yes
													}  
												}
											}

											textbox = {
												layoutstretchfactor_horizontal = 1
												layoutpolicy_horizontal = preferred

												datacontext = "[Scope.GetCountry]"

												text = "[Localize(Concatenate(Scope.GetFlagName,'_var_state'))]"
				
												margin_left = -25
												elide = right
												align = left|nobaseline
												parentanchor = left
												alwaystransparent = yes
												default_format = "#white #bold"
											} 

											vertical_divider = {}

											textbox = {
												layoutstretchfactor_horizontal = 1
												layoutpolicy_horizontal = preferred
												datacontext = "[Scope.GetCountry]"

												text = "[Localize(Concatenate(Scope.GetFlagName,'_green_arow_bellow'))]"
				
												margin_left = 0
												margin_bottom = 0
												elide = right
												align = Hcenter|nobaseline
												parentanchor = left
												alwaystransparent = yes
												default_format = "#white #bold"
											}
											
											vertical_divider = {}

											textbox = {
												layoutstretchfactor_horizontal = 1
												layoutpolicy_horizontal = preferred
												datacontext = "[Scope.GetCountry]"

												text = "[Localize(Concatenate(Scope.GetFlagName,'_red_arow_bellow'))]"
				
												margin_left = 0
												margin_bottom = 0
												elide = right
												align = Hcenter|nobaseline
												parentanchor = left
												alwaystransparent = yes
												default_format = "#white #bold"
											} 
											
											vertical_divider = {} 

											textbox = {
												layoutstretchfactor_horizontal = 1
												layoutpolicy_horizontal = preferred
												datacontext = "[Scope.GetCountry]"
												
												text = "[Localize(Concatenate(Scope.GetFlagName,'_status'))]" 
				
												margin_left = 0
												margin_bottom = 0
												elide = right
												align = Hcenter|nobaseline
												parentanchor = left
												alwaystransparent = yes
												default_format = "#white #bold"
											}   
										}
									}
								}
							}
						}	
					}
				}
			} 
		}
	}
}

