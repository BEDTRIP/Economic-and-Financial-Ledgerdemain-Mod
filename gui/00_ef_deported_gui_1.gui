										#visible = "[GetScriptedGui('ai_quantity_purchasing_10_visibility').IsShown( GuiScope.SetRoot(Market.GetOwner.MakeScope).End)]"

										item = {
											button = {
												using = default_button
												size = { @panel_width 40 }

												hbox = {
													margin = { 12 0 }


													textbox = {
														layoutstretchfactor_horizontal = 1
														layoutpolicy_horizontal = expanding

														datacontext = "[Scope.GetCountry]"

														raw_text = "[Country.GetFlagTextIcon] #v"
														fontsize = 25

														margin_left = 0
														margin_bottom = 1
														elide = right
														align = left|nobaseline
														parentanchor = left
														alwaystransparent = yes
													}

													vertical_divider = {}

													#quantity_purchasing_10_visibility
													textbox = {

														layoutstretchfactor_horizontal = 2
														layoutpolicy_horizontal = expanding
														datacontext = "[Scope.GetCountry]"

														raw_text = "[Market.GetOwner.MakeScope.Var('ai_quantity_purchasing_10').GetValue|+D] @bond!"

														margin_left = 12
														margin_bottom = 1
														elide = right
														align = left|nobaseline
														parentanchor = left
														alwaystransparent = yes
													}

													vertical_divider = {}

													textbox = {
														layoutstretchfactor_horizontal = 1
														layoutpolicy_horizontal = expanding
														datacontext = "[Scope.GetCountry]"

														raw_text = "@gold!"

														margin_left = 10
														margin_bottom = 3
														elide = right
														align = left|nobaseline
														parentanchor = left
														alwaystransparent = yes
													}

													vertical_divider = {}

													textbox = {
														layoutstretchfactor_horizontal = 2
														layoutpolicy_horizontal = expanding
														datacontext = "[Scope.GetCountry]"

														text = "[Market.GetOwner.MakeScope.Var('ai_interest_purchasing_10').GetValue|=%]"

														margin_left = 18
														margin_bottom = 1
														elide = right
														align = left|nobaseline
														parentanchor = left
														alwaystransparent = yes
													}

													vertical_divider = {}

													textbox = {
														layoutstretchfactor_horizontal = 2
														layoutpolicy_horizontal = expanding
														datacontext = "[Scope.GetCountry]"

														text = "[Market.GetOwner.MakeScope.Var('ai_total_bond_value_10').GetValue|D][Market.GetOwner.GetCustom('monetary_system_partiel')]"

														margin_left = 12
														margin_bottom = 1
														elide = right
														align = left|nobaseline
														parentanchor = left
														alwaystransparent = yes
													}

													vertical_divider = {}

													textbox = {
														layoutstretchfactor_horizontal = 2
														layoutpolicy_horizontal = expanding
														datacontext = "[Scope.GetCountry]"

														text = "[Market.GetOwner.MakeScope.Var('ai_interest_per_month_calculated_10').GetValue|+=D][Market.GetOwner.GetCustom('monetary_system_partiel')]"

														margin_left = 12
														margin_bottom = 1
														elide = right
														align = left|nobaseline
														parentanchor = left
														alwaystransparent = yes
													}

													vertical_divider = {}

													textbox = {
														layoutstretchfactor_horizontal = 1
														layoutpolicy_horizontal = expanding
														datacontext = "[Scope.GetCountry]"

														text = "[Market.GetOwner.MakeScope.ScriptValue('ai_selle_bond_maturity_yers_10_reverse')]"

														margin_left = 12
														margin_bottom = 1
														elide = right
														align = left|nobaseline
														parentanchor = left
