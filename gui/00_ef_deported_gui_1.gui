														parentanchor = left|nobaseline
														alwaystransparent = yes
													}

													vertical_divider = {}

													textbox = {
														layoutstretchfactor_horizontal = 2
														layoutpolicy_horizontal = expanding
														datacontext = "[Scope.GetCountry]"

														text = "[Market.GetOwner.MakeScope.Var('ai_interest_per_month_calculated_10').GetValue|+=D][Market.GetOwner.GetCustom('monetary_system_partiel')]"

														margin_left = 12
														margin_bottom = 1
														elide = right
														align = left|nobaseline
														parentanchor = left|nobaseline
														alwaystransparent = yes
													}

													vertical_divider = {}

													textbox = {
														layoutstretchfactor_horizontal = 1
														layoutpolicy_horizontal = expanding
														datacontext = "[Scope.GetCountry]"

														text = "[Market.GetOwner.MakeScope.ScriptValue('ai_selle_bond_maturity_yers_10_reverse')]"

														margin_left = 12
														margin_bottom = 1
														elide = right
														align = left|nobaseline
														parentanchor = left|nobaseline
														alwaystransparent = yes
													}
												}
											}
										}
									}

								}
							}
						}
