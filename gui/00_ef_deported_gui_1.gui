						#ai
						section_header_button = {
							#visible = "[GetScriptedGui('ai_seller').IsShown( GuiScope.SetRoot(GetPlayer.MakeScope).End)]"

							blockoverride "left_text" {
								text = "market_owner_foreign_debt_investment"
							}

							blockoverride "onclick" {
								onclick = "[GetVariableSystem.Toggle('ai_seller')]"
							}

							blockoverride "onclick_showmore" {
								visible = "[Not(GetVariableSystem.Exists('ai_seller'))]"
							}

							blockoverride "onclick_showless" {
								visible = "[GetVariableSystem.Exists('ai_seller')]"
							}
						}
