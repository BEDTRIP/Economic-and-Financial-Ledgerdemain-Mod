#gold_reserve_window
default_popup = {
	name = "gold_reserve_window"
	resizable = yes
	layer = top
	movable = yes

	size = { 600 250 }

	using = Window_Background

	parentanchor = center

	blockoverride "window_header_name" {
		text = "gold_reserve_window"
	}
	blockoverride "header_back_button_visibility" {
		visible = no
	}
	blockoverride "header_close_button_visibility" {
		visible = yes
	}
	blockoverride "header_close_button" {
		onclick = "[ExecuteConsoleCommand( Select_CString( GetVariableSystem.Exists('gold_reserve_window'), 'gui.ClearWidgets gold_reserve_window', 'gui.createwidget gui/ef_dev_and_custom_windows/ef_custom_windows.gui gold_reserve_window' ) )]"
		onclick = "[GetVariableSystem.Toggle('gold_reserve_window')]"
	}

	blockoverride "entire_scrollarea" {
		widget = {

			size = { 1000 1000 }

			using = default_list_position
			direction = vertical

			allow_outside = yes
			ignoreinvisible = no

			
			flowcontainer  = {
				margin_top = 0
				margin_right = 0
				margin_left = 0

				spacing = 5

				direction = vertical
				parentanchor = hcenter
 
				flowcontainer  = {
					margin_top = 0
					margin_right = 0
					margin_left = 0

					spacing = 5

					direction = vertical
					parentanchor = hcenter

					flowcontainer  = {
						margin_top = 0
						margin_right = 0
						margin_left = 0

						spacing = 5

						direction = vertical
						parentanchor = hcenter

						textbox = {
							text = "[concept_central_bank_metal_reserves]"
							parentanchor = hcenter

							align = hcenter|nobaseline
							elide = right
							default_format = "#white #bold"
							autoresize = yes
							fontsize = 30
							allow_outside = yes
							ignoreinvisible = yes
						} 
  
						textbox = { 
							text = "[GetPlayer.MakeScope.ScriptValue('central_bank_metal_reserves_state')|0+] [GetPlayer.GetCustom('monetary_system')]" 
							align = hcenter|nobaseline
							parentanchor = hcenter

							elide = right
							default_format = "#white #bold"
							autoresize = yes
							fontsize = 50
							allow_outside = yes
							ignoreinvisible = yes

							position = { 75 8 }
						}  
					} 

