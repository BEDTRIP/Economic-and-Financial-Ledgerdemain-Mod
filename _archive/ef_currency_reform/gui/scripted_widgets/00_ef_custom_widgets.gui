# Вырезано из gui/scripted_widgets/00_ef_custom_widgets.gui; строки — до выреза (каждая — в своём файле на момент выреза, по порядку).
# строки 901-1146: секция «currency_introduction» (section_header_button + flowcontainer с кнопкой currency_introduction)
			#currency_introduction - temporaire new currency
			section_header_button = { 
				visible = "[GetScriptedGui('extreme_weak_currency_visible').IsShown( GuiScope.SetRoot(GetPlayer.MakeScope).End)]"

				blockoverride "left_text" {
					text = "currency_introduction"
				}

				blockoverride "onclick" {
					onclick = "[GetVariableSystem.Toggle('currency_introduction')]"
					onclick = "[GetScriptedGui('world_currency_list_gerenation_ordered').Execute( GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
				}

				blockoverride "onclick_showmore" {
					visible = "[Not(GetVariableSystem.Exists('currency_introduction'))]"
				}

				blockoverride "onclick_showless" {
					visible = "[GetVariableSystem.Exists('currency_introduction')]"
				}
			}
			flowcontainer = {
				using = default_list_position
				direction = vertical
				visible = "[GetVariableSystem.Exists('currency_introduction')]"

				margin_top = 20
				margin_bottom = 10
				spacing = 15

				flowcontainer = {
					direction = vertical
					parentanchor = hcenter

					spacing = 10

					#ligne
					flowcontainer = {
						direction = horizontal
						parentanchor = hcenter

						spacing = 25

						#extreme_weak_currency_solution_count_player
						flowcontainer = {
							spacing = 15
							direction = vertical

							textbox = {
								autoresize = yes
								text = "extreme_weak_currency_solution_count_player"
								align = hcenter
								parentanchor = hcenter
								fontsize = 20
								multiline = yes
								minimumsize = { 150 20 }
								maximumsize = { 150 -1 }
							}

							textbox = {
								autoresize = yes
								text = "extreme_weak_currency_solution_count_player_2"
								align = hcenter
								parentanchor = hcenter
								fontsize = 20
							} 
							
							background = {
								using = entry_bg_simple
								margin = { 10 10 }
							}

							minimumsize = { 150 120 }
							maximumsize = { 150 120 }
						}
						#monetary_system_icon
						flowcontainer = {
							spacing = 0
							direction = vertical

							textbox = {
								autoresize = yes
								text = "current_modetary_law"
								align = hcenter
								parentanchor = hcenter
								fontsize = 20
								multiline = yes
								minimumsize = { 150 20 }
								maximumsize = { 150 -1 }
							}

							textbox = {
								autoresize = yes
								raw_text = "#T [GetPlayer.GetCustom('monetary_system_icon')]#!"
								align = hcenter
								parentanchor = hcenter
								fontsize = 20
							}

							textbox = {
								autoresize = yes
								raw_text = "#T [GetPlayer.GetCustom('monetary_system_name')]#!"
								align = hcenter
								parentanchor = hcenter
								fontsize = 20
							}

							background = {
								using = entry_bg_simple
								margin = { 10 10 }
							}

							minimumsize = { 150 120 }
							maximumsize = { 150 120 }
						}
						#modifier_currency_value
						flowcontainer = {
							spacing = 15
							direction = vertical

							textbox = {
								autoresize = yes
								text = "modifier_currency_value"
								align = hcenter
								parentanchor = hcenter
								multiline = yes
								minimumsize = { 150 20 }
								maximumsize = { 150 -1 }
							}
							textbox = {
								autoresize = yes
								raw_text = "#T [GetPlayer.GetCustom('modifier_currency_value')]#!"
								align = hcenter
								parentanchor = hcenter
								fontsize = 20
								multiline = yes
								minimumsize = { 100 40 }
								maximumsize = { 100 -1 }
							}

							background = {
								using = entry_bg_simple
								margin = { 10 10 }
							}

							minimumsize = { 150 120 }
							maximumsize = { 150 120 }
						}
					}

					#ligne
					flowcontainer = {
						direction = vertical
						parentanchor = hcenter

						spacing = 25

						#extreme_weak_currency_solution_count_player
						flowcontainer = {
							spacing = 15
							direction = vertical

							textbox = {
								autoresize = yes
								text = "extreme_weak_currency_solution_count_player_txt"
								align = hcenter
								parentanchor = hcenter
								fontsize = 20
								multiline = yes
								minimumsize = { 500 20 }
								maximumsize = { 500 -1 }
							}

						}

						divider_decorative = { }

						#extreme_weak_currency_solution_count_player
						flowcontainer = {
							spacing = 15
							direction = vertical
							parentanchor = hcenter

							flowcontainer = {
								spacing = 5
								direction = vertical
								parentanchor = hcenter

								textbox = {
									raw_text = "#v New [GetPlayer.GetCustom('currency_name')]#! [GetPlayer.GetCustom('currency_good')]#!"

									parentanchor = hcenter
									align = hcenter|nobaseline

									elide = left
									default_format = "#white #bold"
									autoresize = yes
									fontsize = 40
									allow_outside = no
								}
								textbox = {
									raw_text = "1 [GetPlayer.GetCustom('currency_ISO_4217')] ([GetPlayer.GetCustom('currency_symbol')]) = [GetPlayer.MakeScope.ScriptValue('money_value_prevision_new_currency')|D] @silver!"

									parentanchor = hcenter
									align = hcenter|nobaseline

									elide = left
									default_format = "#white #bold"
									autoresize = yes
									fontsize = 33
									allow_outside = no
								}
								textbox = {
									raw_text = "(1 [GetPlayer.GetCustom('currency_ISO_4217')] ([GetPlayer.GetCustom('currency_symbol')]) = [GetPlayer.MakeScope.ScriptValue('money_value_prevision_new_currency_in_gold')|D] @gold!)"

									parentanchor = hcenter
									align = hcenter|nobaseline

									elide = left
									default_format = "#white #bold"
									autoresize = yes
									fontsize = 20
									allow_outside = no
								}
							}

							button_icon_square = {
								name = "currency_introduction"

								#tooltip = "money_value_target_set_x"
								enabled = "[GetScriptedGui('currency_introduction').IsValid( GuiScope.SetRoot(GetPlayer.MakeScope ).End)]"
								onclick = "[GetScriptedGui('currency_introduction').Execute( GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
								using = tooltip_below
								parentanchor = hcenter

								size = { 240 40 }
								align = hcenter|nobaseline
								#margin_left = 12
								text = "currency_introduction"
							}
						}
					}
				}
 
				divider_decorative = { }
			} 
