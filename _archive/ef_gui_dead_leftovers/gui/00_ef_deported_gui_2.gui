				textbox = {
					autoresize = yes
					text = " [GetPlayer.GetGDP|V|D|1*]"
					align = nobaseline
					parentanchor = vcenter
				}
			}
		}
		divider_clean = {}

		flowcontainer = {
			spacing = 5
			margin_left = 5
			container = {
				size = { 100% 100% }
				margin = { 5 5 }
				textbox = {
					autoresize = yes
