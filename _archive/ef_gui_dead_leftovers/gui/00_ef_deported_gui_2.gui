	type vo_plotline_gdp = v3_plotline {
		using = default_list_position

		blockoverride "header" {
			text = "#v GDP#! [GetMetaPlayer.GetPlayedOrObservedCountry.GetCustom('currency_symbol')][GetPlayer.GetGDP|V|D|1*]"
		}
		blockoverride "line_color" {
			color = { .9 .9 .9 1.0 }
		}
		blockoverride "size" {
			size = { 180 80 }
		}
		blockoverride "line_plotpoints" {
			visible = "[Not(IsEmpty(GetPlayer.GetGDPTrend))]"
			plotpoints = "[GetTrendPlotPointsNormalized(GetPlayer.GetGDPTrend, '(CFixedPoint)0', GetMax(GetPlayer.GetGDPTrend) )]"
		}
		blockoverride "maxvalue" {
			text = "[GetMax(GetPlayer.GetGDPTrend)|K]"
		}
		blockoverride "minvalue" {
			raw_text = "0"
		}
		blockoverride "startdate" {
			text = "[GetOldestDate(GetPlayer.GetGDPTrend)]"
		}
		blockoverride "enddate" {
			text = "[GetLatestDate(GetPlayer.GetGDPTrend)]"
		}
		blockoverride "multiitem" {}

		blockoverride "empty_state_visibility" {
			visible = "[IsEmpty(GetPlayer.GetGDPTrend)]"
		}
		blockoverride "empty_state_text" {
			text = "GRAPH_NOT_INITIALIZED"
		}
	}

