# Из gui/00_ef_deported_gui_1.gui, тип market_global_panel_content (вкладка рынка «global», InformationPanel 'msa'),
# между блоком сравнения стран (comparison_of_countries) и блоком покупки облигаций (#purchase_of_bond_debt_visibility).

			#currency_exchange_panel_visibility
			flowcontainer  = {
				margin_top = 0
				margin_right = 0
				margin_left = 0

				direction = vertical
				parentanchor = hcenter

				spacing = 10

				default_header = {
					blockoverride "text" {
						text = "exchange_currency"
					}
				}

				##player = ok -> buy_sell_good_visibility -> in_currency
				flowcontainer = {
					visible = "[GetScriptedGui('currency_exchange_panel_visibility').IsShown( GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
					margin_top = 0
					margin_right = 0
					margin_left = 0
					margin_bottom = 0

					direction = vertical
					parentanchor = hcenter


					#Market.GetOwner = ok
					flowcontainer  = {
						visible = "[GetScriptedGui('currency_exchange_panel_visibility').IsShown( GuiScope.SetRoot(Market.GetOwner.MakeScope).End)]"

						margin_top = 0
						margin_right = 0
						margin_left = 0

						direction = vertical
						parentanchor = hcenter

						spacing = 10

						#selection in_gold/in_currency only witch the global reference currency
						flowcontainer  = {
							visible = "[GetScriptedGui('is_global_monetary_reference_more_button_visibility').IsShown( GuiScope.SetRoot(Market.GetOwner.MakeScope).End)]"

							margin_top = 0
							margin_right = 0
							margin_left = 0

							spacing = 10

							direction = horizontal
							parentanchor = hcenter

							button_icon_square = {
								enabled = "[GetScriptedGui('has_gold_exchange_standard_tech_more_button_visibility').IsValid( GuiScope.SetRoot(GetPlayer.MakeScope ).End)]"

								name = "buy_in_currency_in_currency"
								size = { 250 40 }

								using = tooltip_below

								onclick = "[GetScriptedGui('sell_in_currency_on').Execute( GuiScope.SetRoot(GetPlayer.MakeScope ).End)]"
								textbox = {
									using = fontsize_large
									autoresize = yes
									text = "buy_in_currency_in_currency"
									parentanchor = vcenter|hcenter
									default_format = "#white #bold"
									align = hcenter
								}
							}
							button_icon_square = {
								enabled = "[GetScriptedGui('has_gold_standard_no_gold_exchange_standard_tech_market_panel_visibility').IsValid( GuiScope.SetRoot(GetPlayer.MakeScope ).End)]"

								name = "buy_in_gold_currency"
								size = { 250 40 }

								using = tooltip_below

								onclick = "[GetScriptedGui('sell_in_gold_on').Execute( GuiScope.SetRoot(GetPlayer.MakeScope ).End)]"
								textbox = {
									using = fontsize_large
									autoresize = yes
									text = "buy_in_gold_currency"
									default_format = "#white #bold"
									parentanchor = vcenter|hcenter
									align = hcenter
								}
							}
						}

						#currrrency selection
						flowcontainer  = {
							direction = vertical
							parentanchor = hcenter

							spacing = 10

							divider_decorative = { }

							flowcontainer  = {
								margin_top = 0
								margin_right = 0
								margin_left = 0
								margin_bottom = 0

								spacing = 75

								direction = horizontal

								parentanchor = hcenter

								dropdown_menu_standard = {
									parentanchor = hcenter

									blockoverride "dropdown_properties"
									{
										datamodel = "[GetGlobalList('dropdown_menu_currency')]"
									}

									blockoverride "dropdown_size"
									{
										size = { 400 40 }
									}
									blockoverride "dropdown_list_maxsize" {
										maximumsize = { 400 250 }
									}

									blockoverride "dropdown_active_item_properties"
									{
										text = "[Localize(Concatenate(GetPlayer.MakeScope.Var('currency_selection').GetFlagName,'_name'))]"
									}

									blockoverride "dropdown_button_dropdown"
									{
										button = {
											using = default_button_map_interaction
											size = { 400 40 }

											block "dropdown_item_properties"
											{
												raw_text = "#D Option#!"
											}

											default_format = "#clickable"

											onclick = "[GetScriptedGui('selection_changed_for_currency').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('currency_dropdown_option', MakeScopeFlag(Scope.GetFlagName)).End)]"
										}
									}

									blockoverride "dropdown_item_properties"
									{
										widget = {
											size = { 100% 100% }
											hbox = {
												layoutpolicy_horizontal = expanding
												align = left
												parentanchor = left
												textbox = {
													text = "[Localize(Concatenate(Scope.GetFlagName,'_name_list'))]"
													autoresize = yes
													margin_bottom = 5
													margin_left = 0
													align = left
													parentanchor = left
													using = fontsize_large
													fontsize = 17

												}
											}
										}
									}
								}
