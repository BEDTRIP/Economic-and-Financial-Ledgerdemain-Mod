										size = { 80% 60% }
										position = { 75 8 }


										name = "stockpiling_ammunition_var_state"
										blockoverride "values" {
											value = "[GetPlayer.MakeScope.ScriptValue('stockpiling_ammunition_var_state')]"
											min = 0
											max = 1000000
										}

										textbox = {
											using = fontsize_large
											autoresize = yes
											raw_text = "[GetPlayer.MakeScope.ScriptValue('stockpiling_ammunition_var_state')|D] @ammunition!"
