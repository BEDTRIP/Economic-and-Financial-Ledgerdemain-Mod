# из gui/00_ef_deported_gui_1.gui, строки 87834–131386 (на 2026-10-07), раздел товаров (#buy_sell_good_visibility) в market_global_panel_content

			#buy_sell_good_visibility
			flowcontainer = {
				direction = vertical
				using = default_list_position
