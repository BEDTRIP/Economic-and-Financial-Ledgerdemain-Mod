									margin_top = 0
									margin_right = 0
									margin_left = 0
									margin_bottom = 0

									spacing = 25

									direction = vertical

									visible = "[GetScriptedGui('ammunition_buy_on_v').IsShown( GuiScope.SetRoot(GetPlayer.MakeScope).End)]"

									flowcontainer  = {
										margin_top = 0
										margin_right = 0
										margin_left = 0
										margin_bottom = 0

										direction = vertical

										widget = {
											visible = "[GetScriptedGui('default_ammunition').IsShown( GuiScope.SetRoot(Market.GetOwner.MakeScope).End)]"

											size = { @panel_width_minus_10 45 }
											parentanchor = hcenter

											default_progressbar_horizontal = {
												block "default_progressbar_visible" {
													visible = yes
												}
												size = { 80% 60% }
												position = { 75 8 }


												blockoverride "values" {
													value = "[Market.GetOwner.MakeScope.ScriptValue('stockpiling_ammunition_var_state')]"
													min = 0
													max = 1000000
												}

												textbox = {
													using = fontsize_large
													autoresize = yes
													raw_text = "[Market.GetOwner.MakeScope.ScriptValue('stockpiling_ammunition_var_state')|D3] @ammunition!"
													parentanchor = right|vcenter
													align = right|nobaseline

													#position = { -58 8 }
												}
											}

											button_icon_round_big = {
												size = { 65 65 }

												blockoverride "icon" {
													texture = "gfx/interface/icons/goods_icons/ammunition.dds"
												}

												onclick = "[InformationPanelBar.OpenGoodsPanel(AccessPlayer.AccessFirstMarket.Self, Goods.Self)]"
												onrightclick = "[RightClickMenuManager.ShowForGoods(Goods.AccessSelf)]"

