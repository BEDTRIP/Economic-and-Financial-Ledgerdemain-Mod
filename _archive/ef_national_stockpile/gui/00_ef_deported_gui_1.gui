												text = "[Localize(Concatenate(Scope.GetFlagName,'_green_arow_bellow'))]"
				
												margin_left = 0
												margin_bottom = 0
												elide = right
												align = Hcenter|nobaseline
												parentanchor = left
												alwaystransparent = yes
												default_format = "#white #bold"
											}
											
											vertical_divider = {}

											textbox = {
												layoutstretchfactor_horizontal = 1
												layoutpolicy_horizontal = preferred
												datacontext = "[Scope.GetCountry]"

												text = "[Localize(Concatenate(Scope.GetFlagName,'_red_arow_bellow'))]"
				
												margin_left = 0
												margin_bottom = 0
												elide = right
												align = Hcenter|nobaseline
												parentanchor = left
												alwaystransparent = yes
												default_format = "#white #bold"
											} 
											
											vertical_divider = {} 

											textbox = {
												layoutstretchfactor_horizontal = 1
												layoutpolicy_horizontal = preferred
												datacontext = "[Scope.GetCountry]"
												
												text = "[Localize(Concatenate(Scope.GetFlagName,'_status'))]" 
				
												margin_left = 0
												margin_bottom = 0
												elide = right
												align = Hcenter|nobaseline
												parentanchor = left
												alwaystransparent = yes
												default_format = "#white #bold"
											}   
										}
									}
								}
							}
						}	
					}
				}
			} 
		}
	}
}

