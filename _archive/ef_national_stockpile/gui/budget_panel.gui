# из gui/budget_panel.gui, строки 214–233 (на 2026-10-07), вкладка «Запас»: кнопка (fifth_button) и содержимое

				# stockpile
				blockoverride "fifth_button" {
					text = "STOCKPILE"
				}
				blockoverride "fifth_button_tooltip" {
					tooltip = "STOCKPILE"
				}
				blockoverride "fifth_button_click" {
					onclick = "[InformationPanel.SelectTab('stockpile')]"
				}
				blockoverride "fifth_button_visibility" {
					visible = "[InformationPanel.IsTabSelected('stockpile')]"
				}
				blockoverride "fifth_button_visibility_checked" {
					visible = "[Not( InformationPanel.IsTabSelected('stockpile') )]"
				}
				blockoverride "fifth_button_selected" {
					text = "STOCKPILE"
				}

