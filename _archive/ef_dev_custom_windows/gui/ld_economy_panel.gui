# из gui/ld_economy_panel.gui, строки 41–76 (на 6.10.2026), кнопка «1» вкладки «Экономика» (открывает хаб отладочных окон ef_custom_windows; условие показа закомментировано — была видна всем)
			#E&F debug
			flowcontainer  = {
				#visible = "[GetScriptedGui('EF_debug_mode_visibility').IsShown( GuiScope.SetRoot(GetPlayer.MakeScope).End)]"

 				margin_top = 0
				margin_right = 0
				margin_left = 10

				direction = horizontal
				parentanchor = left

				spacing = 5

				#Panel_1
				button_icon_round = {
					name = "Panel_1"
					size = { 33 33 }


					onclick = "[ExecuteConsoleCommand( Select_CString( GetVariableSystem.Exists('my_ef_custom_windows'), 'gui.ClearWidgets ef_custom_windows', 'gui.createwidget gui/ef_dev_and_custom_windows/ef_custom_windows.gui ef_custom_windows' ) )]"
					onclick = "[GetVariableSystem.Toggle('my_ef_custom_windows')]"

					sing = shimmer
					position = { 0 33 }
					textbox = {
						text = "1"
						align = center|nobaseline
						default_format = "#white #bold"
						autoresize = yes
						fontsize = 25
						allow_outside = no
						ignoreinvisible = yes
						margin_left = 10
					}
				}
			}

