# From gui/ld_cb_rate_panel.gui.

# --- Finances, private banks: summary box «private_bank_bond_holdings»
							flowcontainer = {
								spacing = 5
								direction = vertical

								textbox = {
									autoresize = yes
									text = "private_bank_bond_holdings"
									fontsize = 15

									align = hcenter
									parentanchor = hcenter
									multiline = yes
									minimumsize = { 150 40 }
									maximumsize = { 150 -1 }
									default_format = "#white #bold"
								}

								textbox = {
									autoresize = yes
									raw_text = "[GetPlayer.MakeScope.ScriptValue('funds_from_foreign_debt_total')|D] [GetPlayer.GetCustom('monetary_system')]"
									align = nobaseline
									parentanchor = Hcenter
									fontsize = 20
									default_format = "#white #bold"
								}

								background = {
									using = entry_bg_simple
									margin = { 10 10 }
								}

								minimumsize = { 150 40 }
								maximumsize = { 150 -1 }
							}

# --- Finances, private banks: summary box «private_bank_foreign_reserves»
							flowcontainer = {
								spacing = 5
								direction = vertical

								textbox = {
									autoresize = yes
									text = "private_bank_foreign_reserves"
									fontsize = 15

									align = hcenter
									parentanchor = hcenter
									multiline = yes
									minimumsize = { 150 40 }
									maximumsize = { 150 -1 }
									default_format = "#white #bold"
								}

								textbox = {
									autoresize = yes
									raw_text = "[GetPlayer.MakeScope.ScriptValue('private_bank_foreign_reserves_per_bank')|D] @gold!"
									align = nobaseline
									parentanchor = Hcenter
									fontsize = 20
									default_format = "#white #bold"
								}

								background = {
									using = entry_bg_simple
									margin = { 10 10 }
								}

								minimumsize = { 150 40 }
								maximumsize = { 150 -1 }
							}

# --- Finances, private banks table row: funds textbox
											textbox = {
												datacontext = "[Scope.GetCompany]"

												raw_text = "@bond! [Company.MakeScope.ScriptValue('funds_from_foreign_debt')|D] @gold!"

												fontsize = 18
												default_format = "#white #bold"
												margin_left = 0
												margin_bottom = 1
												elide = right
												align = Hcenter|nobaseline
												parentanchor = left
												alwaystransparent = yes
											}

# --- Finances, private banks table row: foreign currency textbox
											textbox = {
												datacontext = "[Scope.GetCompany]"

												raw_text = "@spe_uni_c! [Company.MakeScope.ScriptValue('private_bank_foreign_reserves_per_bank_gui')|D] @gold!"

												fontsize = 18
												default_format = "#white #bold"
												margin_left = 0
												margin_bottom = 1
												elide = right
												align = Hcenter|nobaseline
												parentanchor = left
												alwaystransparent = yes
											}

# --- Finances: company_Rothschild_Bank_gbr — its currencies, header
				#company_Rothschild_Bank_gbr
				section_header_button = {
					visible = "[GetScriptedGui('company_Rothschild_Bank_gbr_privat_bank_foreign_reserves_visible').IsShown( GuiScope.SetRoot(GetPlayer.MakeScope).End)]"

					#visible = "[GetVariableSystem.Exists('is_ai')]"

					blockoverride "left_text" {
						text = "company_Rothschild_Bank_gbr_privat_bank_foreign_reserves"
					}

					blockoverride "onclick" {
						onclick = "[GetVariableSystem.Toggle('company_Rothschild_Bank_gbr_privat_bank_foreign_reserves')]"
						onclick = "[GetScriptedGui('update_company_Rothschild_Bank_gbr_currency_stored_liste').Execute( GuiScope.SetRoot(GetPlayer.MakeScope).End)]"

					}

					blockoverride "onclick_showmore" {
						visible = "[Not(GetVariableSystem.Exists('company_Rothschild_Bank_gbr_privat_bank_foreign_reserves'))]"
					}

					blockoverride "onclick_showless" {
						visible = "[GetVariableSystem.Exists('company_Rothschild_Bank_gbr_privat_bank_foreign_reserves')]"
					}
				}

# --- Finances: company_Rothschild_Bank_gbr — its currencies, list
					flowcontainer = {
						direction = vertical
						datamodel = "[GetGlobalList('company_Rothschild_Bank_gbr_privat_bank_stored_currency')]"

						item = {
							button = {
								using = default_button
								size = { @panel_width 40 }

								hbox = {
									margin = { 12 0 }

									textbox = {
										layoutstretchfactor_horizontal = 2
										layoutpolicy_horizontal = preferred

										datacontext = "[Scope.GetCountry]"

										raw_text = "[Localize(Concatenate(Scope.GetFlagName,'_name_currency'))]"

										#margin_bottom = -17
										#fontsize = 17
										margin_left = 0
										elide = right
										align = left|nobaseline
										parentanchor = left
										alwaystransparent = yes
										default_format = "#white #bold"
									}

									vertical_divider = {}

									textbox = {
										layoutstretchfactor_horizontal = 2
										layoutpolicy_horizontal = preferred
										datacontext = "[Scope.GetCountry]"

										raw_text = "[Localize(Concatenate(Scope.GetFlagName,'_accumulated'))]"

										margin_left = 0
										margin_bottom = 0
										elide = right
										align = Hcenter|nobaseline
										parentanchor = left
										alwaystransparent = yes
										default_format = "#white #bold"
									}

									vertical_divider = {}

									textbox = {
										layoutstretchfactor_horizontal = 1
										layoutpolicy_horizontal = preferred
										datacontext = "[Scope.GetCountry]"
										raw_text = "[Localize(Concatenate(Scope.GetFlagName,'_money_value_in_gold'))]"

										margin_left = 0
										margin_bottom = 0
										elide = right
										align = Hcenter|nobaseline
										parentanchor = left
										alwaystransparent = yes
										default_format = "#white #bold"
									}


									vertical_divider = {}

									textbox = {
										layoutstretchfactor_horizontal = 2
										layoutpolicy_horizontal = preferred
										datacontext = "[Scope.GetCountry]"

										raw_text = "[Localize(Concatenate(Scope.GetFlagName,'_accumulated_in_gold'))]"

										margin_left = 0
										margin_bottom = 0
										elide = right
										align = Hcenter|nobaseline
										parentanchor = left
										alwaystransparent = yes
										default_format = "#white #bold"
									}

								}
							}
						}
					}

