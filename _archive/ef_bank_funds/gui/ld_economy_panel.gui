# From gui/ld_economy_panel.gui.

# --- the Economy tab: «total_currency_product» box (currency_global_stokpile)
									flowcontainer = {
										direction = vertical

										spacing = 5

										parentanchor = hcenter

										textbox = {
											using = fontsize_large
											autoresize = yes
											text = "total_currency_product"
											parentanchor = hcenter
											align = hcenter
											multiline = yes
											maximumsize = { 150 -1 }

										}
										textbox = {
											using = fontsize_large
											autoresize = yes
											raw_text = "[GetPlayer.MakeScope.ScriptValue('currency_global_stokpile')|+D] [GetPlayer.GetCustom('currency_good')]"
											parentanchor = hcenter
											align = hcenter

										}
										background = {
											using = entry_bg_simple
											margin = { 10 10 }
										}
										minimumsize = { 230 40 }
										maximumsize = { 230 100 }
									}

# --- the Economy tab: «currency_own_by_private_bank» box
									flowcontainer = {
										direction = vertical

										spacing = 5

										textbox = {
											using = fontsize_large
											autoresize = yes
											text = "currency_own_by_private_bank"
											parentanchor = hcenter
											align = hcenter
											multiline = yes
											maximumsize = { 225 -1 }


										}
										textbox = {
											using = fontsize_large
											autoresize = yes
											raw_text = "[GetPlayer.MakeScope.ScriptValue('currency_own_by_private_bank')|+D] [GetPlayer.GetCustom('currency_good')]"
											parentanchor = hcenter
											align = hcenter

										}
										background = {
											using = entry_bg_simple
											margin = { 10 10 }
										}
										minimumsize = { 230 40 }
										maximumsize = { 230 100 }
									}

