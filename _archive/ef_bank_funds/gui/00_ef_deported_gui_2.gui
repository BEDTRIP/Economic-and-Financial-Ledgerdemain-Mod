# From gui/00_ef_deported_gui_2.gui.

# --- type ef_bp_<cur>_c_private_bank_stokpile_piechart
	#dinar
	type ef_bp_dinar_c_private_bank_stokpile_piechart = chart {
		blockoverride "datamodel" {
			datamodel = "[GetGlobalList('global_arbitrage_bank_dinar_variable_list_1_ordered')]"
		}
		blockoverride "heading" {
			text = "EF_BP_CHART_RESERVE_PRIVATE_BANK_HEADING"
		}
		blockoverride "tooltip" {
			##tooltip = "EF_BP_CHART_RESERVE_CURRENCY_HEADING"
			#tooltip = "dinar_algerian_dinar_c_RESERVE_CURRENCY_TOOLTIPS"
		}
		blockoverride "pieslice" { 
			value = "[Scope.GetCompany.MakeScope.ScriptValue('stockpiling_dinar_private_bank_gui')]" 
		}
		blockoverride "color" {
			color = "[Scope.GetCompany.GetCountry.GetMapColor]"
		}

		blockoverride "leftside_info" {
			raw_text = "[Scope.GetCompany.GetName]"
		}
		blockoverride "rightside1_info" {
			raw_text = "#bold [Scope.GetCompany.MakeScope.ScriptValue('stockpiling_dinar_private_bank_gui')|D]#! [GetPlayer.GetCustom('currency_good')]"
		}
		blockoverride "rightside2_info" {
			raw_text = ""
		}
		blockoverride "pie_item_goto_button" {
			button = {
				using = clean_button
				size = { 100% 100% }
			}
		}
		blockoverride "piechartsize" {
			size = { 200 200 }
		}
		blockoverride "minimumsize" {
			minimumsize = { 100 -1 }
		}
		blockoverride "maxverticalslots" {
			maxverticalslots = 10
		}
	}

